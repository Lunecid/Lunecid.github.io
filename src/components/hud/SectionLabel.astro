---
/**
 * The small "[ ■ ] ENGLISH" HUD caption (mockup-port §1.4, D-8). Numbers are the nav's alone (D-8): every other
 * label carries the numberless square mark, drawn in CSS (hud.css .hud-label__sq), never a glyph.
 * `ko` is kept for panel labels that name themselves in both languages; section headings use SectionHead.astro
 * (this caption over a title in the page language). Styling: the global .hud-label classes in src/styles/hud.css.
 */
interface Props {
  ko?: string;
  en: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  id?: string;
  /** false: the caption without the [ ■ ] mark (e.g. inside a bracketed panel that is its own mark). */
  mark?: boolean;
  /** true: a visual caption only; a visually hidden heading names the section (SectionHead captionOnly). */
  ariaHidden?: boolean;
}
const { ko, en, as: Tag = 'p', id, mark = true, ariaHidden = false } = Astro.props;
---
<Tag id={id} class="hud-label" aria-hidden={ariaHidden ? 'true' : undefined}>{mark && <span class="hud-label__mark" aria-hidden="true" lang="en">[<i class="hud-label__sq"></i>]</span>}{ko && <span class="hud-label__ko">{ko}</span>}<span class="hud-label__en" lang="en">{en}</span></Tag>
