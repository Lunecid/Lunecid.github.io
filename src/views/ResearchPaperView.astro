---
// /research/<id>/ (+ /en/): the paper page (D-15, owner's request) — the abstract only, typeset like the first
// page of the IEEE paper, on a white sheet over the dark HUD background. Built from the publication entry;
// HUD nav and footer stay. Page <title>/URL stay trademark-free; the <h1> is the real paper title.
// P-07: a back link to the research page above the sheet (F-005: '← 01 연구' in the game, '← 연구' in the general
// version) and the full-text request line under Code (F-048, the address from getPerson()), in both versions.
import type { CollectionEntry } from 'astro:content';
import type { PageLayout } from '../layouts/page-layout';
import PaperSheet from '../components/research/PaperSheet.astro';
import CaseTrigger from '../components/research/CaseTrigger.astro';
import { FONT_URL, fontFaceCss } from '../lib/fonts';
import { pageHref } from '../lib/links';
import { CASE_IDS, toPaperPage } from '../lib/publications';
import { RIOT_NOTICE_ON_PAGES } from '../config';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { NoticeKey } from '../types';
import type { VariantId } from '../variants/ids';
import { BASE_PATH, getVariant, pageMetaFor } from '../variants';
import { getFactSource, getPerson } from '../lib/portfolio';

interface Props {
  lang: Lang;
  variant: VariantId;
  entry: CollectionEntry<'publications'>;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

/** Preflight Q19: Riot notice on this page when RIOT_NOTICE_ON_PAGES is true; otherwise credits only. */
const PAPER_NOTICES: NoticeKey[] = RIOT_NOTICE_ON_PAGES ? ['riot'] : [];

const { lang, variant, entry, layout: Layout } = Astro.props;
const v = getVariant(variant);
const facts = await getFactSource();
const paper = toPaperPage(entry, lang);
const meta = pageMetaFor('research-story', lang, variant, facts);
// P2-5: the general version sets the sheet on the white page with a thin rule; the game keeps the HUD grid and frame.
const editorial = v.theme === 'editorial';
// The Korean serif (Korean title gloss, 국문 초록, footnote) is set up on the Korean page only; the build subsets
// it to exactly the Hangul inside this page's sheet (scripts/fonts/build.mjs). The general page preloads it with
// font-display: optional: swapped in after the first render, its narrower Hangul rewrapped the title gloss at 375 px
// and moved the authors and the abstract (CLS 0.037). A slow first visit keeps the fallback serif for that view.
const koreanSerif = paper.titleKo !== null || paper.abstractKo !== null ? fontFaceCss(['serifKo'], editorial ? 'optional' : undefined) : null;
// P-07 F-048: the full-text request address; F-005: the way back to the research page, numbered as the game nav does.
const person = await getPerson();
const backHref = pageHref(BASE_PATH.research, { lang, variant });
const backNum = String(v.nav.findIndex((item) => item.key === 'research') + 1).padStart(2, '0');
// D1 (case overlay): a paper with a case study gets a button that opens it over this page. A button does nothing
// without JS, so it shows only under html.js (no-JS readers have the paper itself).
const caseId = (CASE_IDS as readonly string[]).includes(entry.id) ? entry.id : null;
---
<Layout
  lang={lang}
  variant={variant}
  title={meta.title}
  description={meta.description}
  page="research-story"
  section="research"
  sectionIndex={false}
  notices={PAPER_NOTICES}
>
  {koreanSerif && <Fragment slot="head"><style is:inline set:html={koreanSerif}></style>{editorial && <link rel="preload" href={FONT_URL.serifKo} as="font" type="font/woff2" crossorigin />}</Fragment>}
  {caseId && <CaseTrigger />}
  {editorial ? (
    <div class="paper-view paper-view--ed">
      <p class="paper-view__back"><a class="ed-link" href={backHref}><span aria-hidden="true">←</span> {t(lang, 'nav.research')}</a>{caseId && <button type="button" class="ed-btn paper-view__case" data-case={caseId}>{t(lang, 'action.caseStudy')} <span aria-hidden="true">→</span></button>}</p>
      <div class="paper-view__sheet paper-view__sheet--ed">
        <PaperSheet lang={lang} paper={paper} requestEmail={person.email} />
      </div>
    </div>
  ) : (
    <div class="paper-view hud-grid">
      <p class="paper-view__back"><a class="paper-view__back-link" href={backHref}><span aria-hidden="true">←</span> <span class="paper-view__back-num" aria-hidden="true">{backNum}</span> {t(lang, 'nav.research').toUpperCase()}</a>{caseId && <button type="button" class="btn btn--line cut cut--line paper-view__case" data-case={caseId}>{t(lang, 'action.caseStudy')} <span aria-hidden="true">→</span></button>}</p>
      <div class="paper-view__frame bracket">
        <div class="paper-view__sheet">
          <PaperSheet lang={lang} paper={paper} requestEmail={person.email} />
        </div>
      </div>
    </div>
  )}
</Layout>

<style>
  /* Phones: the sheet spans the width (16px padding inside it). From 734px it floats on the HUD grid like a
     document open in a viewer, with the HUD's lime bracket corners around it (decoration only, D-11). */
  .paper-view { padding-block: 0; }
  .paper-view__frame { max-width: calc(46 * 17px + 24px); margin-inline: auto; border: 0; }
  .paper-view__frame::before, .paper-view__frame::after { display: none; }
  .paper-view__sheet { background: var(--paper-bg); }
  /* P-07 F-005: the way back to the research page, above the sheet and on its left edge. The game link is drawn like the
     HUD nav's links (muted, the number in tabular figures; 44px target); the general one is an .ed-link. */
  .paper-view__back { max-width: calc(46 * 17px + 24px); margin-inline: auto; padding: 4px var(--gutter); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
  /* D1: the case-study button; inert without JS, so shown only once html.js confirms the script can run */
  .paper-view__case { appearance: none; border: 0; font-family: inherit; }
  .paper-view--ed .paper-view__case { border: var(--ed-rule-w) solid var(--ed-ink); }
  :global(html:not(.js)) .paper-view__case { display: none; }
  .paper-view__back-link { display: inline-flex; align-items: center; gap: 6px; min-height: var(--tap); font-size: var(--fs-label); color: var(--hud-muted); text-decoration: none; transition: color var(--dur-hover) linear; }
  .paper-view__back-num { font-variant-numeric: tabular-nums; }
  @media (hover: hover) {
    .paper-view__back-link:hover { color: var(--hud-text); }
  }
  .paper-view__back-link:active { color: var(--hud-text); }
  @media (min-width: 734px) {
    .paper-view { padding: 56px var(--gutter) 80px; }
    .paper-view__back { padding: 0 0 8px; }
    .paper-view__frame { padding: 12px; }
    .paper-view__frame::before, .paper-view__frame::after { display: block; }
    .paper-view__sheet { box-shadow: var(--paper-shadow); }
  }

  /* General version (P2-5): the white sheet on the white page with a thin rule instead of the HUD frame and shadow. */
  .paper-view--ed { background: var(--ed-bg); }
  .paper-view__sheet--ed { max-width: calc(46 * 17px + 24px); margin-inline: auto; }
  @media (min-width: 734px) {
    .paper-view--ed { padding: 40px var(--gutter) 64px; }
    .paper-view__sheet--ed { padding: 12px; border: var(--ed-rule-w) solid var(--ed-rule); box-shadow: none; }
  }

  /* Print: only the sheet, black on white — no nav, footer, toasts, grid, frame or shadow. */
  @media print {
    :global(html[data-page="research-story"] body > :not(main)) { display: none !important; }
    :global(html[data-page="research-story"]),
    :global(html[data-page="research-story"] body) { background: var(--paper-bg); color-scheme: light; }
    .paper-view { padding: 0; background: none; }
    .paper-view__back { display: none; }
    .paper-view__case { display: none; }
    .paper-view__frame { max-width: none; padding: 0; border: 0; }
    .paper-view__frame::before, .paper-view__frame::after { display: none; }
    .paper-view__sheet { box-shadow: none; }
  }
</style>
