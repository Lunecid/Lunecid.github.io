---
// Home "[ ■ ] RESEARCH / 연구 하이라이트": the paper (al-folio fields, spec §5 연구 목록) and the paper's own result, the
// AUC dot plot, in one bracketed light-HUD panel (P1-9) instead of the unreadable 160px diagram thumbnail; then the
// NOW PLAYING aside. Emphasis (ORAL) is used for the CoG paper only.
// P2-7: the general version tells the paper as plain text beside the same chart as "그림 2 —" (editorial tone), with the
// §10.2 sentence under the title and 진행 중 as a plain label; the game markup is unchanged. DS-4 (v5): the paper's
// numbers as figure tiles (the first on blue paint), the oral badge (.ed-stamp: real text on a red painted field, one per
// view), the chart with its LightGBM band, and 진행 중 as a yellow painted label cell beside a neutral text cell. Its
// look lives in editorial.css (the scoped rh-ed rules below are no longer used by this markup; they stay so the game
// pages' inlined CSS is unchanged).
import SectionHead from '../hud/SectionHead.astro';
import AucOverallChart from '../research/AucOverallChart.astro';
import PaperLinks from '../research/PaperLinks.astro';
import CaseTrigger from '../research/CaseTrigger.astro';
import StatTiles from '../data/StatTiles.astro';
import type { StatDef } from '../../data/copy/data/home';
import { figureCopy, overallAuc } from '../../data/research/cog-2026';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import type { PaperCardData } from '../../lib/publications';
import { captionFor, getVariant, type VariantId } from '../../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  paper: PaperCardData;
  nowPlaying: string;
  /** Game version: the resolved hero artifact label, e.g. 'FIG · CoG 2026 · AUC BY MODEL' (contract §3.3). */
  figureLabel?: string;
  /** General version only: the §10.2 sentence under the title. */
  intro?: string;
  /** General version only: the chart's figure number on the page. */
  figureNumber?: number;
  /** General version only (DS-4): the paper's headline numbers as figure tiles, and the line naming their source. */
  stats?: StatDef[];
  statsSource?: string;
}

const { lang, variant, paper, nowPlaying, figureLabel = '', intro, figureNumber, stats, statsSource } = Astro.props;
const [figTag, ...figRest] = figureLabel.split(' · ');
---

{variant === 'game' ? (
<section id="research-highlight" class="rh read read-sec" aria-labelledby="rh-title">
  <div class="container">
    <SectionHead variant={variant} id="rh-title" caption={captionFor(getVariant(variant), 'research', lang)} title={t(lang, 'hero.researchHighlight')} />
    <article class="paper lh-frame bracket bracket--sm">
      <div class="paper__body">
        <p class="paper__venue">
          <span lang="en">{paper.venue}</span>
          {paper.oral && <span class="paper__oral" lang="en">{t(lang, 'research.oral')}</span>}
        </p>
        <h3 class="paper__title" lang="en">
          {paper.href ? <a href={paper.href} data-case={paper.caseId ?? undefined}>{paper.title}</a> : paper.title}
        </h3>
        {
          paper.titleGloss && (
            <p class="paper__gloss">
              {paper.titleGloss} <span class="paper__gloss-mark">({t(lang, 'research.gloss')})</span>
            </p>
          )
        }
        <p class="paper__authors" lang="en">
          {paper.authors.map((author, i) => (
            <>{i > 0 && ', '}{author.me ? <strong>{author.name}</strong> : author.name}</>
          ))}
        </p>
        <p class="paper__tldr">{paper.tldr}</p>
        {/* Final review fix 1 item 4: the same link row and disclosures as /research/ (PaperLinks, P2-9): the
            buttons stay on one row and the abstract/BibTeX panels open below it; without JS both read inline. */}
        <PaperLinks lang={lang} paper={paper} idBase="rh" />
      </div>
      <div class="paper__fig">
        <p class="paper__strip" lang="en"><span class="paper__strip-tag">{figTag}</span> · {figRest.join(' · ')}</p>
        <AucOverallChart lang={lang} rows={overallAuc} caption={figureCopy.aucOverall.caption[lang]} alt={figureCopy.aucOverall.alt[lang]} idPrefix="rh-auc" />
      </div>
    </article>
    <div class="now bracket bracket--sm">
      <p class="hud-label" lang="en">[ NOW PLAYING ]</p>
      <p class="now__text">{nowPlaying}</p>
    </div>
  </div>
</section>
) : (
<section id="research-highlight" class="rh-ed ed-sec" aria-labelledby="rh-title">
  <div class="container">
    <SectionHead variant={variant} id="rh-title" caption={captionFor(getVariant(variant), 'research', lang)} title={t(lang, 'hero.researchHighlight')}>{intro}</SectionHead>
    {stats && stats.length > 0 && (
      <div class="ed-rh__figures"><StatTiles items={stats} tone="figure" />{statsSource && <p class="ed-stats__src">{statsSource}</p>}</div>
    )}
    <div class="ed-rh__grid">
      <article class="ed-paper">
        <p class="ed-paper__venue"><span class="ed-label"><span lang="en">{paper.venue}</span></span>{paper.oral && <span class="ed-stamp"><span class="ed-stamp__ink" data-paint-text>{t(lang, 'research.oralPresentation')}</span></span>}</p>
        <h3 class="ed-paper__title" lang="en">{paper.href ? <a class="ed-paper__link" href={paper.href} data-case={paper.caseId ?? undefined}>{paper.title}</a> : paper.title}</h3>
        {paper.titleGloss && <p class="ed-meta">{paper.titleGloss} ({t(lang, 'research.gloss')})</p>}
        <p class="ed-meta ed-paper__authors" lang="en">
          {paper.authors.map((author, i) => (
            <>{i > 0 && ', '}{author.me ? <strong>{author.name}</strong> : author.name}</>
          ))}
        </p>
        <p class="ed-body">{paper.tldr}</p>
        <PaperLinks lang={lang} paper={paper} idBase="rh" />
      </article>
      <AucOverallChart lang={lang} rows={overallAuc} caption={figureCopy.aucOverall.caption[lang]} alt={figureCopy.aucOverall.alt[lang]} idPrefix="rh-auc" tone="editorial" figureNumber={figureNumber} />
      <div class="ed-now"><p class="ed-now__label" data-paint-text>{captionFor(getVariant(variant), 'nowPlaying', lang)}</p><p class="ed-now__text">{nowPlaying}</p></div>
    </div>
  </div>
</section>
)}

{paper.caseId && paper.href && <CaseTrigger />}

<style>
  /* minmax(0, 1fr) + .paper__body { min-width: 0 }: an opened BibTeX box wraps inside the panel instead of widening the page (Review Focus 1) */
  .paper { margin-top: 24px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .paper__body { min-width: 0; }
  .paper__venue { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: var(--fs-meta); color: var(--read-muted); }
  .paper__oral { padding: 1px 7px; font: 800 var(--fs-label)/1.4 var(--font-mono); color: var(--gold-ink); background: var(--gold-wash); border: 1px solid var(--gold-line); }
  .paper__title { margin-top: 6px; font-size: var(--fs-sub); font-weight: 700; line-height: var(--lh-sub); }
  .paper__title a { color: var(--read-text); text-decoration: none; transition: color var(--dur-hover) linear; }
  @media (hover: hover) {
    .paper__title a:hover { color: var(--accent-deep); text-decoration: underline; }
  }
  .paper__title a:active { color: var(--accent-deep); text-decoration: underline; }
  .paper__gloss { margin-top: 6px; font-size: var(--fs-small); color: var(--read-muted); }
  .paper__gloss-mark { white-space: nowrap; }
  .paper__authors { margin-top: 6px; font-size: var(--fs-meta); color: var(--read-muted); }
  .paper__authors strong { color: var(--read-text); }
  .paper__tldr { margin-top: 12px; max-width: var(--measure); }
  /* The paper's own result (the no-art hero uses the same chart in the HUD tone): the chart picks its layout by its
     own width, so the column is 560px (the wide layout, 13px text) where the page has room for it. */
  .paper__fig { min-width: 0; padding-top: 18px; border-top: 1px solid var(--read-line); }
  .paper__fig :global(.chart__scroll) { border: 0; }
  .paper__strip { margin-bottom: 8px; font: 600 var(--fs-label)/1.5 var(--font-mono); letter-spacing: .14em; color: var(--read-muted); }
  .paper__strip-tag { color: var(--read-text); }
  .now { margin-top: 20px; padding: 14px 16px; background: var(--read-card); }
  /* phones: the chart takes the panel's full inner width (the dot plot needs a 280px box for 12px text at 320px) */
  @media (max-width: 733.98px) {
    .paper__fig { margin-inline: -16px; }
    .paper__strip, .paper__fig :global(.chart__caption), .paper__fig :global(.chart__table) { padding-inline: 16px; }
  }
  .now__text { margin-top: 6px; font-size: var(--fs-small); }
  @media (min-width: 1068px) {
    .paper { grid-template-columns: minmax(0, 1fr) minmax(0, 420px); column-gap: 28px; }
    .paper__fig { padding-top: 0; padding-left: 28px; border-top: 0; border-left: 1px solid var(--read-line); }
    .paper__fig :global(.chart__svg--compact) { max-width: 360px; }
  }
  @media (min-width: 1280px) {
    .paper { grid-template-columns: minmax(0, 1fr) 589px; }
  }
  /* General version (P2-7) */
  .rh-ed__grid { display: grid; gap: 28px; margin-top: 20px; }
  .rh-ed__title { margin-top: 6px; font-size: var(--fs-sub); font-weight: 700; line-height: var(--lh-sub); }
  .rh-ed__now { margin-top: 24px; padding-top: 10px; border-top: var(--ed-rule-w) solid var(--ed-rule); }
  @media (min-width: 1068px) {
    .rh-ed__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 48px; align-items: start; }
  }
</style>
