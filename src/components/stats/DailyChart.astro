---
import SectionHead from '../hud/SectionHead.astro';
import type { Lang } from '../../i18n/ui';
import { formatDate, formatNumber, t } from '../../i18n/utils';
import type { PageVariant } from '../../variants';

interface Props {
  lang: Lang;
  variant: PageVariant;
  daily: { day: string; count: number }[];
  fetchedAt: string;
  maxAgeDays: number;
}
const { lang, variant, daily, fetchedAt, maxAgeDays } = Astro.props;
const DATE_HEADER = { ko: '날짜', en: 'Date' } as const;
const W = 600;
const H = 160;
const GAP = 2;
const step = daily.length > 0 ? W / daily.length : W;
const max = Math.max(1, ...daily.map((d) => d.count));
const bars = daily.map((d, i) => {
  const h = Math.round((d.count / max) * (H - 4));
  return { day: d.day.slice(0, 10), count: d.count, x: Number((i * step).toFixed(2)), w: Number(Math.max(1, step - GAP).toFixed(2)), y: H - h, h };
});
const first = bars[0]?.day ?? '';
const last = bars[bars.length - 1]?.day ?? '';
---
{bars.length > 0 && (
  <section id="daily" class:list={['stats', variant === 'neutral' ? 'nt-sec' : 'read']} aria-labelledby="stats-daily-title" data-fetched-at={fetchedAt} data-max-age-days={maxAgeDays}>
    <div class="container">
      <SectionHead variant={variant} id="stats-daily-title" caption={variant === 'neutral' ? t(lang, 'nav.stats') : t(lang, 'section.dailyVisits')} title={t(lang, 'stats.daily')} />
      <div class="stats__chart-wrap">
        <p class="stats__chart-max tnum" aria-hidden="true">{formatNumber(max, lang)}</p>
        <div class="stats__chart-scroll" tabindex="0" role="region" aria-labelledby="stats-daily-title">
          <svg class="stats__chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-labelledby="stats-daily-svg-title">
            <title id="stats-daily-svg-title">{`${t(lang, 'stats.daily')}: ${formatDate(first, lang)} – ${formatDate(last, lang)}; max ${formatNumber(max, lang)}`}</title>
            <line class="stats__max-line" x1="0" y1="4" x2={W} y2="4" />
            {bars.map((b) => (
              <rect class="stats__bar" x={b.x} y={b.y} width={b.w} height={b.h}><title>{`${formatDate(b.day, lang)} · ${formatNumber(b.count, lang)}`}</title></rect>
            ))}
          </svg>
        </div>
      </div>
      <p class="stats__axis"><span>{formatDate(first, lang)}</span><span>{formatDate(last, lang)}</span></p>
      <details class="stats__details">
        <summary id="stats-daily-table-label">{t(lang, 'action.viewAsTable')}</summary>
        <div class="stats__table-scroll" tabindex="0" role="region" aria-labelledby="stats-daily-title stats-daily-table-label">
          <table class="stats__table">
            <thead><tr><th scope="col">{DATE_HEADER[lang]}</th><th scope="col">{t(lang, 'stats.visits')}</th></tr></thead>
            <tbody>
              {bars.map((b) => <tr><td><time datetime={b.day}>{formatDate(b.day, lang)}</time></td><td class="tnum">{formatNumber(b.count, lang)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>
)}

<script>
  import '../../scripts/stale-guard';
</script>

<style>
  .stats { padding-block: 0 var(--section-pad-y); }
  .stats__chart-wrap { margin-top: 16px; position: relative; }
  .stats__chart-max {
    position: absolute; top: 0; right: 0; z-index: 1; margin: 0; padding: 0 2px;
    font: 600 12px/1.2 var(--font-mono); color: var(--read-muted); background: var(--read-card);
  }
  .stats__chart-scroll { overflow-x: auto; }
  .stats__chart { display: block; width: 100%; height: 160px; }
  .stats__bar { fill: var(--read-muted); }
  .stats__max-line { stroke: var(--read-muted); stroke-width: 1; stroke-dasharray: 4 3; vector-effect: non-scaling-stroke; }
  .stats__axis { display: flex; justify-content: space-between; margin-top: 6px; font: 500 13px/1.4 var(--font-mono); color: var(--read-muted); }
  .stats__details { margin-top: 12px; }
  .stats__details summary { display: inline-flex; align-items: center; min-height: var(--tap); cursor: pointer; color: var(--accent-deep); }
  .stats__table-scroll { overflow-x: auto; }
  .stats__table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .stats__table th, .stats__table td { padding: 6px 10px; text-align: left; border-bottom: 1px solid var(--read-line); }
  .stats__table td:last-child, .stats__table th:last-child { text-align: right; }
  /* P2-11: on neutral pages the table toggle is a link in the neutral accent (accent-deep is the game green). */
  .stats.nt-sec .stats__details summary { color: var(--nt-accent); }
</style>
