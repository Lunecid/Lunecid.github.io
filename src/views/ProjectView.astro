---
// One project case study (spec §3 사례 연구 틀): PROJECT DETAILS → body with each figure right after the paragraph that
// first cites it (P1-7) → "게임 팀에게 / 연구 기여" → figures not cited inline → links, plus the certificate modal when
// the project has an award whose redacted certificate image exists. Everything after PROJECT DETAILS shares the one
// centred reading column (--measure), so the page keeps one left edge; figures widen symmetrically to 760px.
// P2-5: the general version sets the body on white (article.ed-prose) with its headings in the serif heading face;
// P-06 F-065: in both versions the body's "그림 N" / "Figure N" citations link to the figure (#figure-N).
import type { CollectionEntry } from 'astro:content';
import type { PageLayout } from '../layouts/page-layout';
import ProjectDetails from '../components/projects/ProjectDetails.astro';
import FigureList from '../components/projects/FigureList.astro';
import ProjectLinks from '../components/projects/ProjectLinks.astro';
import ProjectAudience from '../components/projects/ProjectAudience.astro';
import Figure from '../components/common/Figure.astro';
import ImageViewer from '../islands/ImageViewer';
import type { Certificate } from '../lib/certificates';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { t } from '../i18n/utils';
import { projectPageMeta } from '../data/copy/pages';
import { getAwards, getFactSource } from '../lib/portfolio';
import { projectDetailRows } from '../lib/projects';
import { buildCertificate } from '../lib/certificates';
import { coverFigureIndex, linkFigureCitations, placeFigures, serifHeadings } from '../lib/figures';
import type { VariantId } from '../variants/ids';
import { getVariant } from '../variants';

interface Props {
  lang: Lang;
  variant: VariantId; // used from P1-9 on
  entry: CollectionEntry<'projects'>;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

const { lang, variant, entry, layout: Layout } = Astro.props;
const v = getVariant(variant);
const editorial = v.theme === 'editorial';
const facts = await getFactSource();
const { data } = entry;
const body = entry.rendered?.html;
if (body === undefined) throw new Error(`ProjectView: ${entry.id} has no rendered body`);
// A figure that is the cover image is shown once, in PROJECT DETAILS, with its number and caption (fix round 1).
const coverIndex = coverFigureIndex(data.cover?.src, data.figures);
// F-065 (P-06): figure N is the body's Figure, a FigureList entry or the cover, each with id="figure-N".
const linkedBody = linkFigureCitations(body, data.figures.length);
const placed = placeFigures(linkedBody, data.figures.map((figure, index) => (index === coverIndex ? undefined : figure.inlineAfter)));
const parts = placed.parts;
const rest = placed.rest.filter((index) => index !== coverIndex);
const numbered = data.figures.map((figure, index) => ({ ...figure, number: index + 1 }));
const bodyParts = parts.map((part) => (part.kind === 'html' ? part : { kind: 'figure' as const, figure: numbered[part.index]! }));
const meta = projectPageMeta(data.title, data.summary, lang);
const rows = projectDetailRows(data, lang);

const awardRef = data.award;
const awardEntry = awardRef ? (await getAwards()).find((a) => a.id === awardRef.certificate) : undefined;
const certificate: Certificate | null = awardEntry ? await buildCertificate(awardEntry, lang) : null;
const award = awardRef
  ? {
      name: awardRef.name,
      ...(certificate
        ? {
            certificateId: certificate.id,
            certificateHref: certificate.fullSrc,
            certificateWidth: certificate.width,
            certificateHeight: certificate.height,
            certificateSrcSet: certificate.srcSet,
            certificateSizes: certificate.sizes,
            certificateAlt: certificate.alt,
            certificateCaption: certificate.caption,
          }
        : {}),
    }
  : undefined;
const cited = coverIndex >= 0 ? numbered[coverIndex] : undefined;
const figure = data.cover
  ? { src: data.cover.src, alt: data.cover.alt, label: data.cover.label, ...(cited ? { number: cited.number, caption: cited.caption, ...(cited.table ? { table: cited.table } : {}) } : {}) }
  : undefined;
const hasViewer = certificate !== null || data.figures.some((_, i) => i !== coverIndex);
---

<Layout lang={lang} variant={variant} title={meta.title} description={meta.description} page="project" section="projects" sectionIndex={false}>
  <ProjectDetails lang={lang} variant={variant} title={data.title} rows={rows} figure={figure} award={award}>
    <p>{data.summary}</p>
  </ProjectDetails>
  {/* .prose.read (read.css) is a full-width light band with the centred reading column; .ed-prose (editorial.css) is
      the general version's reading column on white */}
  <article class:list={['prose', editorial ? 'ed-prose' : 'read']}>
    {bodyParts.map((part) =>
      part.kind === 'html' ? (
        <Fragment set:html={editorial ? serifHeadings(part.html) : part.html} />
      ) : (
        <Figure variant={variant} lang={lang} src={part.figure.src} alt={part.figure.alt} caption={part.figure.caption} number={part.figure.number} class="figure--inline" table={part.figure.table} />
      ),
    )}
  </article>
  {data.audience && <ProjectAudience lang={lang} variant={variant} audience={v.modules.includes('audienceGame') ? data.audience : { research: data.audience.research }} />}
  <FigureList lang={lang} variant={variant} figures={rest.map((index) => numbered[index]!)} />
  <ProjectLinks lang={lang} variant={variant} links={data.links} />
  {hasViewer && (
    <ImageViewer
      client:idle
      labels={{
        dialog: t(lang, 'modal.viewer'),
        close: t(lang, 'action.close'),
        previous: t(lang, 'viewer.previous'),
        next: t(lang, 'viewer.next'),
        counter: ui[lang]['viewer.counter'],
      }}
    />
  )}
</Layout>

<script>
  // Markdown tables (figures.ts boxTables): a box that overflows becomes a named, focusable scroll region.
  import '../scripts/table-scroll';
</script>
