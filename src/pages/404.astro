---
// GitHub Pages serves this one dist/404.html for every unknown path (R-1): one neutral page, rendered in Korean, with
// both version homes and a language switch. EN_404_SCRIPT (src/lib/en-404.ts) rewrites it to English before first
// paint when the path starts with /en/ (/en/…, /en/game/…, /en/data/…). No game module, no achievement trigger (A-8).
import NeutralLayout from '../layouts/NeutralLayout.astro';
import { PAGE_META } from '../data/copy/pages';
import { t } from '../i18n/utils';
import { EN_404_SCRIPT } from '../lib/en-404';
import { homeHref } from '../lib/links';
import { chooserRoute } from '../lib/routes';

// The 404 meta holds no fact token, so it is read directly (no collection read: the page also renders in vitest).
const meta = PAGE_META['not-found'].ko;
---
<NeutralLayout lang="ko" title={meta.title} description={meta.description} page="not-found" noindex altLangHref={chooserRoute('en')} ogSlug="home">
  <section class="nf" aria-labelledby="nf-title">
    <h1 id="nf-title" class="nf__title" data-nf-title>{t('ko', '404.title')}</h1>
    <p class="nf__message" data-nf-message>{t('ko', '404.message')}</p>
    <ul class="nf__links" role="list">
      <li><a href={homeHref('ko', 'game')} data-nf-home="game">{t('ko', '404.gameHome')}</a></li>
      <li><a href={homeHref('ko', 'data')} data-nf-home="data">{t('ko', '404.dataHome')}</a></li>
    </ul>
  </section>
</NeutralLayout>

<script is:inline set:html={EN_404_SCRIPT} />

<style>
  .nf { max-width: var(--container); margin-inline: auto; padding: 64px var(--gutter) 80px; }
  .nf__title { font-size: var(--fs-display); line-height: var(--lh-display); font-weight: 800; color: var(--nt-ink); }
  .nf__message { margin-top: 16px; max-width: var(--measure); color: var(--nt-muted); }
  .nf__links { margin: 24px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .nf__links a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--nt-accent); font-weight: 700; text-underline-offset: 3px; }
</style>
