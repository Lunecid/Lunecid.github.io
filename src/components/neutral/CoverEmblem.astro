---
// Styles: src/styles/chooser.css (one external stylesheet for the chooser).
// The chooser covers' emblems (MO-23): the gamepad on the game cover in HUD lines, the bar chart on the printout in ink
// with dot-shaded bars. Original line drawings from the approved prototype (no third-party path data); decorative,
// inline, no external reference. The emblem grows with its file (a size container) from 440px.
interface Props {
  kind: 'game' | 'data';
}
const { kind } = Astro.props;
---
{kind === 'game' ? (
  <svg class="emblem" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true" focusable="false">
    <rect class="em__frame" x="1.5" y="1.5" width="61" height="61"></rect>
    <path class="em__corner" d="M1 10V1h9M54 1h9v9M63 54v9h-9M10 63H1v-9"></path>
    <path class="em__tick" d="M32 1.5v4M32 58.5v4M1.5 32h4M58.5 32h4"></path>
    <path class="em__line" d="M22 21h20c6 0 9.5 3 11.5 9l3 10.5c1.3 4.5-1.9 8.1-5.9 6.9-2-.6-3.2-2-4.4-4l-1.8-3H19.6l-1.8 3c-1.2 2-2.4 3.4-4.4 4-4 1.2-7.2-2.4-5.9-6.9l3-10.5c2-6 5.5-9 11.5-9Z"></path>
    <path class="em__line" d="M19.5 26h3v3h3v3h-3v3h-3v-3h-3v-3h3Z"></path>
    <circle class="em__line" cx="43" cy="27.1" r="1.6"></circle>
    <circle class="em__line" cx="46.4" cy="30.5" r="1.6"></circle>
    <circle class="em__line" cx="43" cy="33.9" r="1.6"></circle>
    <circle class="em__line" cx="39.6" cy="30.5" r="1.6"></circle>
    <path class="em__line" d="M28.5 35h2.5M33 35h2.5M29.5 25h5"></path>
  </svg>
) : (
  <svg class="emblem emblem--ink" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true" focusable="false">
    <defs><pattern id="cover-em-dots" width="2.4" height="2.4" patternUnits="userSpaceOnUse"><circle class="em__dots" cx="1.2" cy="1.2" r=".62"></circle></pattern></defs>
    <rect class="em__frame" x="1.5" y="1.5" width="61" height="61"></rect>
    <path class="em__corner" d="M1 10V1h9M54 1h9v9M63 54v9h-9M10 63H1v-9"></path>
    <path class="em__tick" d="M32 1.5v4M32 58.5v4M1.5 32h4M58.5 32h4M14 41h-2.5M14 32h-2.5M14 23h-2.5"></path>
    <path class="em__bar" d="M18 50V40h6v10ZM28 50V34h6v16ZM38 50V28h6v22Z"></path>
    <path class="em__line" d="M14 13v37h37"></path>
    <path class="em__line" d="M21 33l10-6 10-6 8-7M44.5 14H49v4.5"></path>
    <circle class="em__dot" cx="21" cy="33" r="1.7"></circle>
    <circle class="em__dot" cx="31" cy="27" r="1.7"></circle>
    <circle class="em__dot" cx="41" cy="21" r="1.7"></circle>
  </svg>
)}
