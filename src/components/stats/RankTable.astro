---
import SectionHead from '../hud/SectionHead.astro';
import type { Lang } from '../../i18n/ui';
import { formatNumber, t } from '../../i18n/utils';

interface Props {
  lang: Lang;
  id: 'top-pages' | 'referrers';
  title: string;
  rows: { label: string; count: number }[];
  fetchedAt: string;
  maxAgeDays: number;
}
const { lang, id, title, rows, fetchedAt, maxAgeDays } = Astro.props;
---
{rows.length > 0 && (
  <section id={id} class="stats read" aria-labelledby={`${id}-title`} data-fetched-at={fetchedAt} data-max-age-days={maxAgeDays}>
    <div class="container">
      <SectionHead id={`${id}-title`} caption={t(lang, id === 'top-pages' ? 'section.topPages' : 'section.referrers')} title={title} />
      <div class="stats__table-scroll" tabindex="0" role="region" aria-labelledby={`${id}-title`}>
        <table class="stats__table">
          <thead><tr><th scope="col">{title}</th><th scope="col">{t(lang, 'stats.visits')}</th></tr></thead>
          <tbody>
            {rows.map((r) => <tr><td class="stats__label">{r.label}</td><td class="stats__num tnum">{formatNumber(r.count, lang)}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}

<script>
  import '../../scripts/stale-guard';
</script>

<style>
  .stats { padding-block: 0 var(--section-pad-y); }
  .stats__table-scroll { margin-top: 12px; overflow-x: auto; }
  .stats__table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .stats__table th, .stats__table td { padding: 6px 10px; text-align: left; border-bottom: 1px solid var(--read-line); }
  .stats__label { overflow-wrap: anywhere; }
  .stats__num, .stats__table th:last-child { text-align: right; white-space: nowrap; }
</style>
