---
// The general version's hero (spec §8 히어로, §10.2, B-10, B-12; DS-4, v5): in the rail a tinted label block (the caption
// and an aria-hidden job line: the canonical address in capitals and the last update); in the main column the painted
// English job title (identity headline en, aria-hidden, white on the red field, a yellow cell beside it), the name (the
// page's h1), the headline, the tagline, three stat tiles (the status and evidence facts, in their sentences' order),
// the projects button (the page's one filled button) and the CV link. Below, the map spread: the school-zone risk
// heatmap as "그림 1 —" in a white frame over a neutral tint block and a blue painted field with a yellow cell.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { formatDate, t } from '../../i18n/utils';
import { SITE } from '../../config';
import type { StatDef } from '../../data/copy/data/home';
import { splitTagline } from '../../data/copy/hero';
import { editorialFigureLabel } from '../../lib/figures';
import { fitWidths, sourceSize } from '../../lib/images';
import { todayIso } from '../../lib/records';
import PaintMark from './PaintMark.astro';
import StatTiles from './StatTiles.astro';

interface Props {
  lang: Lang;
  caption: string;
  name: string;
  headline: string;
  /** The Latin display words: the identity headline in English (both languages), one painted line per word. */
  display: string;
  tagline: string;
  /** The status and evidence facts as tiles (dataHomeCopy.heroStats, resolved). */
  stats: StatDef[];
  projects: { label: string; href: string };
  /** docLabel names the PDF (D-7): the link's title and, visually hidden, part of its name. */
  cv: { label: string; href: string; docLabel: string };
  /** projectTitle: the linked project's title, visually hidden in the link's name (the button beside it may carry the same label). */
  figure: { src: ImageMetadata; alt: string; caption: string; href: string; linkLabel: string; projectTitle: string };
}
const { lang, caption, name, headline, display, tagline, stats, projects, cv, figure } = Astro.props;
const address = new URL(Astro.url.pathname, SITE.url);
const job = [`${address.host}${address.pathname}`.toUpperCase(), `${t(lang, 'footer.lastUpdated')} ${formatDate(todayIso(new Date()), lang)}`];
const [taglineA, taglineB] = splitTagline(tagline);
const figureLabel = editorialFigureLabel(lang, 1);
const figureTab = figureLabel.replace(/\s*—$/, '');
---
<section class="ed-hero dhero" aria-labelledby="hero-name">
  <div class="container ed-g ed-hero__grid">
    <div class="ed-tblock"><p class="ed-label">{caption}</p><p class="ed-tblock__meta" aria-hidden="true"><span lang="en">{job[0]}</span><span>{job[1]}</span></p></div>
    <div class="ed-hero__panel">
      <div class="ed-hero__mark" aria-hidden="true"><p class="ed-hero__bars" lang="en" data-display data-paint-text>{display.split(/\s+/).map((word) => <span>{word}</span>)}</p><PaintMark kind="hero" /></div>
      <h1 id="hero-name" class="ed-hero__name">{name}</h1>
      <p class="dhero__headline">{headline}</p>
      <p class="dhero__tagline">{taglineB ? <Fragment><span class="ed-cl">{taglineA}</span> <span class="ed-cl">{taglineB}</span></Fragment> : taglineA}</p>
      <StatTiles items={stats} tone="plain" />
      <ul class="ed-hero__actions" role="list">
        <li><a class="ed-btn ed-btn--fill" href={projects.href}>{projects.label} <span aria-hidden="true">→</span></a></li>
        <li><a class="ed-link" href={cv.href} title={cv.docLabel} download>{cv.label} <span aria-hidden="true">↓</span><span class="sr-only"> — {cv.docLabel}</span></a></li>
      </ul>
    </div>
    <figure class="ed-figure ed-spread">
      <i class="ed-spread__y" aria-hidden="true"></i>
      <div class="ed-spread__img">
        <Picture
          src={figure.src}
          alt={figure.alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={fitWidths([480, 720, 1040], sourceSize(figure.src).width)}
          sizes="(min-width: 1248px) 790px, (min-width: 1068px) calc(68vw - 60px), (min-width: 734px) calc(82vw - 70px), calc(100vw - 66px)"
          priority
        />
        <span class="ed-chip ed-spread__tab" aria-hidden="true">{figureTab}</span>
      </div>
      <figcaption class="ed-figcap ed-spread__cap"><span class="ed-figcap__num">{figureLabel}</span> {figure.caption} <a class="ed-link dhero__figlink" href={figure.href}>{figure.linkLabel}<span class="sr-only"> — {figure.projectTitle}</span> <span aria-hidden="true">→</span></a></figcaption>
    </figure>
  </div>
</section>
