---
// /projects/ (spec §3): SELECT YOUR PROJECT grid in the version's projectsOrder (game: CoG wide card first),
// a tag filter, and the GitHub section when build-time GitHub data is usable. P2-6: the general version lists the
// projects as editorial rows (ProjectListItem) in an <ol>; TagFilter is unchanged.
import type { PageLayout } from '../layouts/page-layout';
import PageHeader from '../components/hud/PageHeader.astro';
import TagFilter from '../components/projects/TagFilter.astro';
import ProjectCartridge from '../components/projects/ProjectCartridge.astro';
import ProjectListItem from '../components/data/ProjectListItem.astro';
import GitHubSection from '../components/github/GitHubSection.astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import { pageHref } from '../lib/links';
import { TAG_KEYS, type TagKey } from '../content/tags';
import { getFactSource, resolveOrder } from '../lib/portfolio';
import { toCartridge, type CartridgeProps } from '../lib/projects';
import { toPaperCartridge } from '../lib/publications';
import { generated, usableGitHub } from '../lib/generated';
import type { VariantId } from '../variants/ids';
import { captionFor, getVariant, pageMetaFor } from '../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

const { lang, variant, layout: Layout } = Astro.props;
const ctx = { lang, variant };
const v = getVariant(variant);
const editorial = v.theme === 'editorial';
const facts = await getFactSource();
const meta = pageMetaFor('projects', lang, variant, facts);
const toCard = (item: Awaited<ReturnType<typeof resolveOrder>>[number]): CartridgeProps =>
  item.kind === 'project' ? toCartridge(item.entry, ctx) : toPaperCartridge(item.entry, lang, pageHref(item.entry.data.caseStudy ?? '', ctx));
const cards: CartridgeProps[] = (await resolveOrder(v.orders.projectsOrder, lang)).map(toCard);
// P2-8 (controller ruling 5): a tag with fewer than 2 projects (often just one card, or one with no tags at all
// besides it) adds filter-button noise without doing useful filtering, so it is hidden entirely.
const tagCounts = new Map<TagKey, number>();
for (const card of cards) for (const key of card.tagKeys) tagCounts.set(key, (tagCounts.get(key) ?? 0) + 1);
const filterKeys = TAG_KEYS.filter((key) => (tagCounts.get(key) ?? 0) >= 2);
// The page's LCP image is the first card that has one (the CoG card's Fig. 1,
// owner decision 2026-10-05: Fig. 1 is the cover (reverses F-045)).
const firstImage = cards.findIndex((card) => card.cover !== undefined);
const github = usableGitHub(generated.github());
---

<Layout lang={lang} variant={variant} title={meta.title} description={meta.description} page="projects" section="projects" sectionIndex={true}>
  <PageHeader lang={lang} variant={variant} label={captionFor(v, 'pageProjects', lang)} title={t(lang, 'projects.title')} intro={meta.description} />
  <section id="project-list" class:list={editorial ? 'ed-sec' : ['sec', 'hud-grid']} aria-labelledby="project-list-title">
    <div class:list={['container', { 'container--hud': !editorial }]}>
      <h2 id="project-list-title" class="sr-only">{t(lang, 'projects.listLabel')}</h2>
      <TagFilter lang={lang} keys={filterKeys} controls="project-grid" />
      {editorial ? (
        <ol id="project-grid" class="ed-list" role="list">
          {cards.map((card, i) => <ProjectListItem {...card} priority={i === firstImage} />)}
        </ol>
      ) : (
        <div id="project-grid" class="cart-grid">
          {cards.map((card, i) => <ProjectCartridge {...card} priority={i === firstImage} />)}
        </div>
      )}
    </div>
  </section>
  <GitHubSection lang={lang} variant={variant} data={github} />
</Layout>
