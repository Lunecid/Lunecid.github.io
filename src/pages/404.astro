---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_META } from '../data/copy/pages';
import { t } from '../i18n/utils';
import { EN_404_SCRIPT } from '../lib/en-404';

// GitHub Pages serves this one dist/404.html for every unknown ko or en path. It is rendered once, in Korean
// (altLangHref stays null: a 404 has no real bilingual counterpart, so it gets no <link rel="alternate"> either).
// P2-15 (controller ruling 9): EN_404_SCRIPT (src/lib/en-404.ts) rewrites it to the English 1:1 equivalent
// (spec §10) when the attempted path started with /en/ — see that file for why it is a plain inline script, not
// this component's own <script> (which Astro turns into a deferred ES module).
const meta = PAGE_META['not-found'].ko;
// shared page: NeutralLayout from P1-10 (404: P1-16)
---
<BaseLayout lang="ko" variant="game" title={meta.title} description={meta.description} page="not-found" altLangHref={null} noindex ogSlug="home">
  <section class="go hud-grid" aria-labelledby="go-title">
    <div class="go__inner">
      <p class="hud-label" lang="en">[ ERROR 404 ]</p>
      <h1 id="go-title" class="go__title">
        <span class="go__big" lang="en">{t('ko', '404.title')}</span>
        <span class="go__plain">{t('ko', '404.message')}</span>
        <span class="go__plain go__plain--en" lang="en">{t('en', '404.message')}</span>
      </h1>
      <p class="go__continue" lang="en">{t('ko', '404.continue')}</p>
      <div class="go__actions" data-go-actions>
        <a class="btn btn--fill cut" href="/">{t('ko', '404.home')}</a>
        <a class="btn btn--line cut cut--line" href="/projects/">{t('ko', '404.projects')}</a>
      </div>
      <p class="go__en" lang="en" data-go-secondary><a href="/en/">{t('en', '404.home')}</a><span aria-hidden="true"> · </span><a href="/en/projects/">{t('en', '404.projects')}</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { emitTrigger } from '../lib/achievements';
  // AchievementHost (BaseLayout; its script drains the trigger queue) maps visit-404 → the hidden achievement
  // "game-over". Kept as a normal (deferred) module script: unlike the language swap, its timing does not matter
  // (no visible flash risk), and it needs the shared trigger-queue helper. EN_404_SCRIPT (below) independently
  // patches the host's language and labels to English before the host's own script starts, so this call's ko/en
  // makes no difference to what the toast eventually shows.
  emitTrigger('visit-404');
</script>

<script is:inline set:html={EN_404_SCRIPT} />

<style>
  /* The KO/EN switch EN_404_SCRIPT adds (no counterpart in the default Korean render, see the note above).
     Two variants, like the site's own .hud-nav__lang--bar / --panel: --bar only ≥ 734px (plenty of room in the
     always-visible bar), --panel only < 734px, inside the menu panel (hidden until opened) instead of crowding
     the tight mobile bar — fix round 1 item 5: that crowding could wrap the bar to a second line the scrim
     (positioned by the fixed --nav-h) does not account for, covering the Close/CV controls. */
  :global(.nf-lang-switch) {
    color: var(--hud-text);
    font: 500 13px/1 var(--font-mono);
    text-decoration: none;
  }
  :global(.nf-lang-switch--bar) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    padding-inline: 4px;
  }
  :global(.nf-lang-switch--bar:hover) {
    color: var(--accent);
  }
  :global(.nf-lang-switch--panel) {
    display: none;
  }
  @media (max-width: 733.98px) {
    :global(.nf-lang-switch--bar) {
      display: none;
    }
    :global(.nf-lang-switch--panel) {
      display: block;
      margin-top: 4px;
    }
    :global(.nf-lang-switch--panel a) {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      color: var(--hud-text);
      font: 500 13px/1 var(--font-mono);
      text-decoration: none;
    }
  }
</style>

<style>
  .go { min-height: calc(100svh - var(--nav-h)); display: grid; place-items: center; padding: 64px var(--gutter); text-align: center; }
  .go__inner { max-width: 640px; }
  .go__title { margin: 0; }
  .go__big { display: block; margin-top: 12px; font: 800 var(--fs-display)/1.07 var(--font-mono); letter-spacing: .08em; color: var(--hud-strong); }
  .go__plain { display: block; margin-top: 16px; font-size: var(--fs-sub); font-weight: 700; line-height: var(--lh-sub); color: var(--hud-text); }
  .go__plain--en { margin-top: 4px; font-size: var(--fs-small); font-weight: 500; color: var(--hud-muted); }
  .go__continue { margin-top: 28px; font: 600 14px/1 var(--font-mono); letter-spacing: .3em; color: var(--hud-muted); }
  .go__actions { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .go__en { margin-top: 16px; font-size: 14px; color: var(--hud-muted); }
  .go__en a { display: inline-flex; align-items: center; min-height: var(--tap); padding-inline: 6px; color: var(--accent); }
  /* G-019 interim: landscape phones — keep 404 actions clear of the bottom GAME OVER toast (toast stays bottom). */
  @media (orientation: landscape) and (max-height: 500px) {
    .go {
      place-items: start center;
      padding-block: 24px calc(120px + env(safe-area-inset-bottom));
      overflow-y: auto;
    }
  }
</style>
