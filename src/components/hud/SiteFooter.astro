---
/**
 * Footer on every page (mockup-port §14.5, spec §4/§8/§11): /stats/ /privacy/ /credits/ links,
 * "마지막 업데이트" = build date in Asia/Seoul, the "모션 끄기" toggle, and the rights-holder notices
 * for what this page shows (always rendered in NOTICE_KEYS order).
 */
import type { Lang } from '../../i18n/ui';
import { formatDate, t } from '../../i18n/utils';
import { isCurrentPath } from '../../lib/footer-nav';
import { chooserHref, pageHref } from '../../lib/links';
import { noticeLines as linesFor } from '../../lib/notices';
import { SITE } from '../../config';
import type { NoticeKey } from '../../types';
import { SHARED_NAV } from '../../variants/neutral';

interface Props {
  lang: Lang;
  notices: NoticeKey[];
  builtAt: Date;
}
const { lang, notices, builtAt } = Astro.props;

const parts = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).formatToParts(builtAt);
const part = (type: 'year' | 'month' | 'day'): string => parts.find((p) => p.type === type)?.value ?? '';
const builtIso = `${part('year')}-${part('month')}-${part('day')}`;

const noticeLines = linesFor(notices);
// P-04: getPerson() reads the resume collection, which the vitest container does not load; its email and github
// are SITE.email and SITE.githubUrl, read here directly (as HomeView and RecordsView do).
const person = { email: SITE.email, github: SITE.githubUrl };
const pathname = Astro.url.pathname;

const links = SHARED_NAV.map((item) => ({ href: pageHref(item.base, { lang, variant: null }), label: t(lang, item.label) }));
links.push({ href: chooserHref(lang, { choose: true }), label: t(lang, 'nav.chooser') });
---
<footer class="site-footer">
  <div class="container container--hud site-footer__inner">
    <p class="site-footer__copy">{t(lang, 'footer.copyright', { year: part('year') })}</p>
    <ul class="site-footer__contact" role="list">
      <li><a class="site-footer__chip" href={`mailto:${person.email}`}><span class="site-footer__chip-face cut cut--line"><svg class="site-footer__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 3.5h13v9h-13z M1.5 3.5 8 8.5l6.5-5" /></svg>{person.email}</span></a></li>
      <li><a class="site-footer__chip" href={person.github}><span class="site-footer__chip-face cut cut--line" lang="en">{t(lang, 'action.github')} <span aria-hidden="true">↗</span></span></a></li>
    </ul>
    <nav class="site-footer__nav" aria-label={t(lang, 'footer.siteInfo')}>
      <ul class="site-footer__links" role="list">
        {links.map((link) => <li><a href={link.href} aria-current={isCurrentPath(link.href, pathname) ? 'page' : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <p class="site-footer__updated">{t(lang, 'footer.lastUpdated')} <time datetime={builtIso}>{formatDate(builtIso, lang)}</time></p>
    {/* Fix round 2 item 1: fix round 1's constant aria-label fixed the aria-pressed/name *agreement* problem but
        broke WCAG 2.5.3 Label in Name the other way — the accessible name ("모션 줄이기"/"Reduce motion") never
        matched the visible text, which still changed ("모션 끄기"/"모션 켜기"/"기기 설정으로 꺼짐"). The standard
        pattern: the visible label is now itself constant (so it doubles as the accessible name — no aria-label
        needed), state is conveyed by aria-pressed plus a separate aria-hidden HUD chip (ON/OFF, fixed English
        like the achievement toast's "ACHIEVEMENT UNLOCKED" kicker — decorative, not a11y-load-bearing), and the
        OS-forced-off explanation is a visible note *outside* the button.
        Fix round 3 item 1: that note's id must NOT be wired in via a static aria-describedby here — a `hidden`
        element that is the DIRECT target of aria-describedby still supplies its text in Chrome's actual AX tree
        (the `hidden` attribute only stops a hidden element's content from being pulled in during traversal of an
        ancestor's accessible-text computation; it does not stop the browser from using a hidden element that is
        itself the referenced node). With a static reference here, every state — including the ordinary,
        not-OS-forced default — announced "Off by device setting" as if it were always true. aria-describedby is
        now added/removed in sync() below, present only while osForced is actually true. */}
    <button
      type="button"
      class="site-footer__motion"
      aria-pressed="false"
      data-motion-toggle
    >{t(lang, 'action.reduceMotion')} <span class="site-footer__motion-chip" lang="en" aria-hidden="true" data-motion-chip>OFF</span></button>
    <p id="motion-os-note" class="site-footer__motion-note" data-motion-os-note hidden>{t(lang, 'action.motionOsOff')}</p>
    {noticeLines.length > 0 && (
      <div class="site-footer__notices">
        {noticeLines.map((line) => (
          <p class="site-footer__notice" lang={line.english ? 'en' : undefined}>{t(lang, line.key)}</p>
        ))}
      </div>
    )}
  </div>
</footer>

<script>
  import { initMotionToggles } from '../../scripts/motion-toggle';
  initMotionToggles();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--hud-divider);
    padding-block: 18px 24px;
    font: 500 var(--fs-caption)/1.6 var(--font-mono);
    color: var(--hud-muted);
  }
  /* F-002: Korean footer mono labels use sans so spaces stay narrow. */
  .site-footer__copy:lang(ko) {
    font-family: var(--font-sans);
    letter-spacing: 0;
  }
  .site-footer__updated:lang(ko) {
    font-family: var(--font-sans);
    letter-spacing: 0;
  }
  .site-footer a:lang(ko) {
    font-family: var(--font-sans);
    letter-spacing: 0;
  }
  .site-footer__inner {
    display: grid;
    gap: 8px;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }
  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--hud-text);
    transition: color var(--dur-hover) linear;
  }
  @media (hover: hover) {
    .site-footer a:hover { color: var(--accent); }
  }
  .site-footer a:active { color: var(--accent); }
  /* P-04 (F-001): the contact row in the hero envelope chip style (Hero.astro .hero__chip). */
  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
  }
  .site-footer__chip {
    text-decoration: none;
  }
  .site-footer__chip-face {
    --c: var(--cut-chip);
    --cut-line: var(--hud-line);
    --cut-fill: var(--hud-panel);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font: 600 var(--fs-caption)/1.4 var(--font-mono);
    letter-spacing: .02em;
  }
  @media (hover: hover) {
    .site-footer__chip:hover .site-footer__chip-face { --cut-line: var(--accent); }
  }
  .site-footer__chip:active .site-footer__chip-face { --cut-line: var(--accent); }
  .site-footer__icon {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .site-footer__motion {
    justify-self: start;
    min-height: var(--tap);
    padding: 0 12px;
    background: none;
    border: 1px solid var(--hud-line);
    color: var(--hud-muted);
    font: inherit;
    cursor: pointer;
    transition: color var(--dur-hover) linear, border-color var(--dur-hover) linear;
  }
  .site-footer__motion[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* P2-7: disabled (the OS setting already forces it) — pressed-styled but not interactive. */
  .site-footer__motion:disabled {
    cursor: not-allowed;
    opacity: .7;
  }
  .site-footer__motion:lang(ko) {
    font-family: var(--font-sans);
  }
  .site-footer__motion-chip {
    display: inline-block;
    margin-inline-start: 6px;
    padding: 1px 5px;
    font: 700 12px/1.4 var(--font-mono); /* site-wide floor: no rendered text below 12px */
    letter-spacing: .04em;
    border: 1px solid currentColor;
    border-radius: 2px;
    vertical-align: 1px;
  }
  .site-footer__motion-note {
    font-family: var(--font-sans);
    color: var(--hud-muted);
  }
  .site-footer__notices {
    display: grid;
    gap: 4px;
  }
  .site-footer__notice {
    font-family: var(--font-sans);
    line-height: 1.5;
  }
  @media (min-width: 1068px) {
    .site-footer__inner {
      /* Row 1 as before P-04: copy, links, updated, motion toggle. The P-04 contact row sits on row 2 under
         columns 1-3, beside the motion note (column 4), so the links keep their one-row width. */
      grid-template-columns: auto 1fr auto auto;
      align-items: center;
      column-gap: 20px;
    }
    .site-footer__contact {
      grid-column: 1 / 4;
      grid-row: 2;
    }
    .site-footer__notices {
      grid-column: 1 / -1;
    }
    /* Fix round 3 item 1: the note is 5th in source order, so default grid auto-placement would wrap it to a new
       row starting at column 1 — the far left, under .site-footer__copy, nowhere near the button it describes.
       Pin it under the motion button's own column instead. */
    .site-footer__motion-note {
      grid-column: 4;
      grid-row: 2;
      justify-self: start;
    }
  }
</style>
