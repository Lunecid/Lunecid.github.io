---
// Tag filter for /projects/ (spec §3 "카트리지 그리드 + 태그 필터"). Single choice, aria-pressed buttons.
// Without JS the whole group stays hidden and every cartridge is visible (Review Focus 5).
// The script toggles `hidden` on every [data-tags] item inside #<controls>.
import { ui, type Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { TAG_KEYS, tagLabel, type TagKey } from '../../content/tags';

interface Props {
  lang: Lang;
  keys: TagKey[];
  controls: string;
}

const { lang, keys, controls } = Astro.props;
// P2-8 (controller ruling 5): a tag with fewer than 2 projects adds noise, not a useful filter — hidden entirely.
const ordered = TAG_KEYS.filter((key) => keys.includes(key));
const countTemplate = ui[lang]['projects.count'];
const countTemplateOne = ui[lang]['projects.countOne'];
---

<div
  class="tag-filter"
  role="group"
  aria-label={t(lang, 'projects.filterLabel')}
  data-tag-filter
  data-controls={controls}
  data-count-template={countTemplate}
  data-count-template-one={countTemplateOne}
>
  <button type="button" class="tag-filter__btn" aria-pressed="true" aria-controls={controls} data-tag-all>{t(lang, 'projects.filterAll')}</button>
  {
    ordered.map((key) => (
      <button type="button" class="tag-filter__btn" aria-pressed="false" aria-controls={controls} data-tag={key}>{tagLabel(key, lang)}</button>
    ))
  }
  <p class="tag-filter__status sr-only" role="status" data-tag-filter-status></p>
</div>

<script>
  // P2-8 (controller ruling 5): the selection lives in ?tag=, restored on load and on browser back/forward, so
  // leaving a project and returning (or sharing the filtered URL) does not silently reset to "all".
  const TAG_PARAM = 'tag';

  function initTagFilter(root: HTMLElement): void {
    const grid = document.getElementById(root.dataset.controls ?? '');
    if (!grid) return;
    const status = root.querySelector<HTMLElement>('[data-tag-filter-status]');
    const template = root.dataset.countTemplate ?? '{n}';
    const templateOne = root.dataset.countTemplateOne ?? template;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button'));
    const validKeys = new Set(buttons.map((b) => b.dataset.tag).filter((key): key is string => key !== undefined));
    // Fix round 2 item 8: tracks the tag `apply()` last actually applied, so the popstate listener below can tell
    // a real filter change (back/forward past a click) from a same-page history entry that has nothing to do
    // with the filter (a skip-link or any other in-page #hash jump also pushes a history entry the browser will
    // later pop).
    let current: string | null = null;

    // Fix round 1 minor: `announce` is false for the initial-load call — a role="status" region should not speak
    // up the moment the page appears, only in response to something the visitor did (a click, or a real
    // navigation via back/forward).
    const apply = (key: string | null, { updateUrl = true, announce = true }: { updateUrl?: boolean; announce?: boolean } = {}): void => {
      for (const button of buttons) {
        const pressed = key === null ? button.hasAttribute('data-tag-all') : button.dataset.tag === key;
        button.setAttribute('aria-pressed', String(pressed));
      }
      let visible = 0;
      for (const item of Array.from(grid.querySelectorAll<HTMLElement>('[data-tags]'))) {
        const match = key === null || (item.dataset.tags ?? '').split(' ').includes(key);
        item.hidden = !match;
        if (match) visible += 1;
      }
      if (status && announce) status.textContent = (visible === 1 ? templateOne : template).replace('{n}', String(visible));
      if (updateUrl) {
        const url = new URL(location.href);
        if (key === null) url.searchParams.delete(TAG_PARAM);
        else url.searchParams.set(TAG_PARAM, key);
        history.replaceState(history.state, '', url);
      }
      current = key;
    };

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest<HTMLButtonElement>('button');
      if (!button || !root.contains(button)) return;
      const key = button.dataset.tag ?? null;
      // Pressing the active tag again returns to "all".
      apply(key !== null && button.getAttribute('aria-pressed') === 'true' ? null : key);
    });

    const fromUrl = (): string | null => {
      const key = new URL(location.href).searchParams.get(TAG_PARAM);
      return key !== null && validKeys.has(key) ? key : null;
    };
    // An unknown/stale ?tag= (a removed tag, a typo, a hand-edited URL) shows "all" — and fix round 1 minor: the
    // address bar is corrected to match (dropped via replaceState), not left pointing at a value the UI ignores.
    const rawParam = new URL(location.href).searchParams.get(TAG_PARAM);
    const hadInvalidParam = rawParam !== null && !validKeys.has(rawParam);
    apply(fromUrl(), { updateUrl: hadInvalidParam, announce: false });
    // Fix round 2 item 8: only announce (and only re-apply at all) when the tag this popstate lands on actually
    // differs from the one already showing — a #hash-only history entry (e.g. the skip link, or ImageViewer's
    // `#view-<id>`) fires popstate too, but ?tag= never changed, so there is nothing to announce.
    window.addEventListener('popstate', () => {
      const next = fromUrl();
      if (next === current) return;
      apply(next, { updateUrl: false });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tag-filter]').forEach(initTagFilter);
</script>

<style>
  .tag-filter { display: none; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  :global(html.js) .tag-filter { display: flex; }
  .tag-filter__btn {
    min-height: var(--tap); padding: 0 14px;
    border: 1px solid var(--hud-line); border-radius: 0; background: var(--hud-panel); color: var(--hud-text);
    font: 600 var(--fs-label)/1 var(--font-sans); cursor: pointer;
    transition: color var(--dur-hover) linear, background-color var(--dur-hover) linear, border-color var(--dur-hover) linear, transform var(--dur-press) var(--ease-out);
  }
  @media (hover: hover) {
    .tag-filter__btn:hover { border-color: var(--accent); }
  }
  .tag-filter__btn[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .tag-filter__btn:active { transform: scale(.96); }
  /* F-022: no scale under reduce; pressed/aria colour states stay. */
  :global(:root[data-motion="reduce"]) .tag-filter__btn:active { transform: none; }
</style>
