---
// The short head of /records/ (P2-19) instead of repeating the home profile: the ID photo beside the greeting (96–120px
// on phones), name, status, a one-line intro (the tagline), the three PDFs as cut-corner buttons (D-7 labels), contact,
// and an in-page bar to the sections recruiters look for (학력 · 수상 · 기술 · 지원 요건 대응 · PDF). No education list
// here: QUEST LOG right below is the one education list on the page.
import { Picture } from 'astro:assets';
import photo from '../../assets/photo/photo-id.webp';
import GhostArt from '../hud/GhostArt.astro';
import SectionLabel from '../hud/SectionLabel.astro';
import DocButtons from './DocButtons.astro';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { fitWidths, sourceSize } from '../../lib/images';
import { captionFor, getVariant } from '../../variants';
import type { VariantId } from '../../variants/ids';

interface Props {
  lang: Lang;
  /** §1.8: the ghost art is game-only (characterArt); contract §4.4 keeps this prop for the P2 editorial markup. */
  variant: VariantId;
  name: string;
  /** Spec §9.1 role line (게임 데이터 분석가 · 연구자 / Game Data Analyst · Researcher). */
  headline: string;
  status: string;
  tagline: string;
  documents: { id: string; label: string; href: string }[];
  /** The filled button: the version's résumé in the page language (D-7); defaults to getVariant(variant).documents.resume[lang]. */
  primary?: string;
  contact: { email: string; github: string; dacon: string };
  ids?: { scholar: string | null; orcid: string | null };
}

const { lang, variant, name, headline, status, tagline, documents, contact, ids } = Astro.props;
const primary = Astro.props.primary ?? getVariant(variant).documents.resume[lang];
const researcherLinks = [
  ids?.scholar ? { label: 'Google Scholar', href: ids.scholar } : null,
  ids?.orcid ? { label: 'ORCID', href: ids.orcid } : null,
].filter((link): link is { label: string; href: string } => link !== null);
const jumps = [
  { href: '#education', label: t(lang, 'records.education') },
  // F-098 (b): one Publications jump for PhD readers; keep the other five recruiter links.
  { href: '#publications', label: lang === 'ko' ? '논문' : 'Publications' },
  { href: '#awards', label: t(lang, 'records.awards') },
  { href: '#skills', label: t(lang, 'records.skills') },
  { href: '#job-fit', label: t(lang, 'jobfit.title') },
  { href: '#documents', label: 'PDF' },
];
---
{variant === 'game' ? (
<section id="profile" class="rhead read" aria-labelledby="profile-title">
  {getVariant(variant).modules.includes('characterArt') && <GhostArt side="right" />}
  <div class="container">
    <div class="rhead__grid">
      <Picture
        class="rhead__photo"
        src={photo}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={fitWidths([120, 240, 354], sourceSize(photo).width)}
        sizes="(min-width: 1068px) 176px, (min-width: 734px) 150px, 112px"
        priority
        alt={t(lang, 'card.photoAlt')}
      />
      <div class="rhead__intro">
        <SectionLabel variant={variant} en={captionFor(getVariant(variant), 'profile', lang)} />
        <h2 id="profile-title" class="rhead__hello">{`${t(lang, 'section.hello')}!`}</h2>
        <p class="rhead__name">{name}</p>
        <p class="rhead__role">{headline}</p>
        <p class="rhead__status">{status}</p>
      </div>
      <div class="rhead__more">
        <p class="rhead__tagline">{tagline}</p>
        <div class="rhead__docs"><DocButtons variant={variant} documents={documents} primary={primary} /></div>
        <ul class="rhead__contact" role="list">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.github}>GitHub</a></li>
          <li><a href={contact.dacon}>DACON</a></li>
          {researcherLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>
    <nav class="rnav" aria-label={t(lang, 'records.jump')} data-screen-only>
      <ol class="rnav__list" role="list">
        {jumps.map((jump) => <li><a class="rnav__link" href={jump.href}>{jump.label}</a></li>)}
      </ol>
    </nav>
  </div>
</section>
) : (
  <section id="profile" class="rhead-ed ed-sec" aria-labelledby="profile-title">
    <div class="container">
      <div class="rhead-ed__grid">
        <Picture
          class="rhead__photo"
          src={photo}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={fitWidths([120, 240, 354], sourceSize(photo).width)}
          sizes="(min-width: 1068px) 176px, (min-width: 734px) 150px, 112px"
          priority
          alt={t(lang, 'card.photoAlt')}
        />
        <div class="rhead-ed__intro">
          <SectionLabel variant={variant} en={captionFor(getVariant(variant), 'profile', lang)} />
          <h2 id="profile-title" class="rhead-ed__hello" data-serif>{`${t(lang, 'section.hello')}!`}</h2>
          <p class="rhead-ed__name">{name}</p>
          <p class="ed-meta">{status}</p>
        </div>
        <div class="rhead-ed__more">
          <p class="ed-body">{tagline}</p>
          <div class="rhead-ed__docs"><DocButtons variant={variant} documents={documents} primary={primary} /></div>
          <ul class="ed-links" role="list">
            <li><a class="ed-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a class="ed-link" href={contact.github}>GitHub <span aria-hidden="true">↗</span></a></li>
            <li><a class="ed-link" href={contact.dacon}>DACON <span aria-hidden="true">↗</span></a></li>
            {researcherLinks.map((link) => <li><a class="ed-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></li>)}
          </ul>
        </div>
      </div>
      <nav class="rnav-ed" aria-label={t(lang, 'records.jump')}>
        <ol class="ed-links" role="list">
          {jumps.map((jump) => <li><a class="ed-link" href={jump.href}>{jump.label}</a></li>)}
        </ol>
      </nav>
    </div>
  </section>
)}

<style>
  .rhead { position: relative; overflow: hidden; padding-block: 32px 0; }
  .rhead > .container { position: relative; z-index: 1; }
  .rhead__grid {
    display: grid; grid-template-columns: 112px minmax(0, 1fr); grid-template-areas: "photo intro" "more more";
    gap: 20px 18px; align-items: center;
  }
  /* P2-22: the re-cropped photo with a 1px hairline so its white background never melts into the band */
  .rhead__grid :global(.rhead__photo) {
    grid-area: photo; display: block; width: 112px; height: auto; aspect-ratio: 3 / 4; object-fit: cover;
    border: 1px solid var(--read-line); background: var(--read-card);
  }
  /* Final fix 2 item 6: the grid item is the <picture> Astro wraps around the img (the class above lands on the img),
     so it takes the photo area itself. It used to be auto-placed into the first row only, which stretched that row to
     the photo's height and left a ~117px empty band between the status line and the tagline from 734px on. */
  .rhead__grid > :global(picture) { grid-area: photo; }
  .rhead__intro { grid-area: intro; min-width: 0; }
  /* F-046 (P-08): weight 800 like the page H1 and smaller than it at every width (28/34/40 under 32/48/56) */
  .rhead__hello { margin-top: 4px; font-size: 28px; font-weight: 800; line-height: 1.2; }
  .rhead__name { margin-top: 6px; font-size: var(--fs-sub); font-weight: 800; line-height: var(--lh-sub); }
  .rhead__role { margin-top: 4px; font-size: var(--fs-small); font-weight: 700; line-height: 1.5; color: var(--read-text); }
  .rhead__status { margin-top: 4px; font-size: var(--fs-meta); line-height: 1.6; color: var(--read-muted); }
  .rhead__more { grid-area: more; min-width: 0; }
  .rhead__tagline { max-width: var(--measure); font-size: var(--fs-body); font-weight: 700; line-height: var(--lh-body); }
  .rhead__docs { margin-top: 16px; }
  .rhead__contact { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 0 18px; font-size: var(--fs-small); }
  .rhead__contact a { display: inline-flex; align-items: center; min-height: var(--tap); }
  /* In-page bar: square mono-caps links on a hairline, like a HUD tab row */
  .rnav { margin-top: 24px; border-top: 1px solid var(--read-line-strong); border-bottom: 1px solid var(--read-line); }
  /* F-071 (P-08): 8px between neighbouring targets on phones, across and between rows */
  .rnav__list { display: flex; flex-wrap: wrap; gap: 8px 8px; }
  .rnav__link {
    display: inline-flex; align-items: center; justify-content: center; min-height: var(--tap); min-width: var(--tap); padding-inline: 10px;
    font-size: var(--fs-meta); font-weight: 700; color: var(--read-text); text-decoration: none;
    transition: color var(--dur-hover) linear, background-color var(--dur-hover) linear;
  }
  /* Final fix 2 item 16 / round 2 item 3: every link keeps padding on both sides, so the shortest label ("학력") is a
     44px target too and every text gap is the same; the first link reaches into the container's gutter instead (its
     text stays on the section's left edge). The old one-sided padding made it 34px wide, and a min-width then widened
     only its gap. */
  /* F-071 (P-08): the 8px list gap is taken; the 10px padding stays (8px would make '학력' narrower than 44px, and its
     min-width would then widen only its own gap). */
  .rnav__list li:first-child .rnav__link { margin-left: -10px; }
  @media (hover: hover) {
    .rnav__link:hover { color: var(--accent-deep); text-decoration: underline; text-underline-offset: .2em; }
  }
  .rnav__link:active { color: var(--accent-deep); text-decoration: underline; text-underline-offset: .2em; }
  @media (min-width: 734px) {
    .rhead { padding-top: 44px; }
    /* Final fix 2 item 6: two content-sized rows, and the photo really spans both (the <picture> rule above). */
    .rhead__grid {
      grid-template-columns: 150px minmax(0, 1fr); grid-template-rows: auto auto; grid-template-areas: "photo intro" "photo more";
      column-gap: 28px; align-items: start; align-content: start;
    }
    .rhead__grid :global(.rhead__photo) { width: 150px; }
    .rhead__hello { font-size: 34px; }
  }
  @media (min-width: 1068px) {
    .rhead__grid { grid-template-columns: 176px minmax(0, 1fr); column-gap: 36px; }
    .rhead__grid :global(.rhead__photo) { width: 176px; }
    .rhead__hello { font-size: 40px; }
  }
  /* F-046: on short landscape screens the page H1 shrinks to min(--fs-display, 12svh) (PageHeader); the greeting
     shrinks with it and stays below it. */
  @media (min-width: 734px) and (max-height: 500px) {
    .rhead__hello { font-size: min(34px, 9svh); }
  }
  @media (min-width: 1068px) and (max-height: 500px) {
    .rhead__hello { font-size: min(40px, 9svh); }
  }
  /* General version (P2-8) */
  .rhead-ed__grid { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px 20px; align-items: start; }
  .rhead-ed__more { grid-column: 1 / -1; display: grid; gap: 12px; }
  .rhead-ed__hello { margin-top: 4px; font-size: var(--fs-h2); line-height: var(--lh-h2); }
  .rhead-ed__name { margin-top: 4px; font-size: var(--fs-sub); font-weight: 700; }
  .rnav-ed { margin-top: 20px; padding-top: 8px; border-top: var(--ed-rule-w) solid var(--ed-rule); }
  /* two-syllable jump labels (학력, 수상, …) are narrower than 44px: the target keeps the 44×44 minimum */
  .rnav-ed .ed-link { min-width: var(--tap); justify-content: center; }
  @media (min-width: 734px) {
    .rhead-ed__grid { grid-template-columns: 150px minmax(0, 1fr); }
  }
  @media (min-width: 1068px) {
    .rhead-ed__grid { grid-template-columns: 176px minmax(0, 1fr) minmax(0, 1fr); column-gap: 32px; }
    .rhead-ed__more { grid-column: auto; }
  }
</style>
