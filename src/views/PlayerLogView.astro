---
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import recordsYaml from '../data/game-records.yaml?raw';
import { parseYamlList } from '../content/yaml-loader';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/hud/PageHeader.astro';
import GameAchievements from '../components/player-log/GameAchievements.astro';
import MembershipRow from '../components/player-log/MembershipRow.astro';
import SiteAchievementList from '../components/player-log/SiteAchievementList.astro';
import { membershipCard, playerLogCopy } from '../data/copy/player-log';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import { ui } from '../i18n/ui';
import AccountLinks from '../islands/AccountLinks';
import FavoriteGames from '../islands/FavoriteGames';
import ImageViewer from '../islands/ImageViewer';
import { SHOWCASE_ONLY, characterCredit, characters } from '../lib/characters';
import { TILE_SOURCES, accountLinksLabels, accountStatus, accountStatusJson, buildAccountView } from '../lib/account-view';
import { relayOrigin } from '../lib/csp';
import { buildFavoriteGames, buildFavoriteTiles } from '../lib/favorites';
import { generated } from '../lib/generated';
import { availableAchievements } from '../lib/achievements';
import { soundAvailability, steamButtonAvailable } from '../lib/public-assets';
import { recordViews } from '../lib/game-records';
import { evidence } from '../lib/game-records.server';
import { ACHIEVEMENT_TRIGGERS, GAME_IDS, NOTICE_KEYS } from '../types';
import { resolveDeep } from '../lib/facts';
import { getFactSource } from '../lib/portfolio';
import { getVariant, pageMetaFor, resolveIdentity } from '../variants';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const facts = await getFactSource();
const identity = resolveIdentity(getVariant('game'), lang, facts);
const meta = pageMetaFor('player-log', lang, 'game', facts);
const copy = resolveDeep(playerLogCopy[lang], lang, facts);

// Collections do not promise insertion order: sort by the shared id lists (same order as the YAML files).
const games = (await getCollection('favorites')).map((e) => e.data).sort((a, b) => GAME_IDS.indexOf(a.id) - GAME_IDS.indexOf(b.id));
const defs = (await getCollection('achievements'))
  .map((e) => e.data)
  .sort((a, b) => ACHIEVEMENT_TRIGGERS.indexOf(a.trigger) - ACHIEVEMENT_TRIGGERS.indexOf(b.trigger));

// D-13: until an account feed exists, the locked games (Steam) stay out of the showcase.
// The bgm-on achievement is listed only when the BGM file exists.
const showcase = await buildFavoriteGames(games.filter((g) => !g.locked), lang);
const tiles = buildFavoriteTiles(games, lang);
// LINKED ACCOUNTS (account-link AL-10): both switches must be on — the committed favorites.yaml switch and an ok,
// fresh feed (R-4). With any switch on the island always renders, client:idle (R-8), even with no tile to show.
// The showcase and GameAchievements get no feeds (R-6, DV-4): FavoriteGames' AccountPanel stays asleep.
const accountFeeds = generated.accounts();
const riotLinks = generated.links();
const accountTiles = await buildAccountView(games, accountFeeds, riotLinks, generated.accountImages(), lang);
const anyAccountEnabled = games.some((g) => g.integration.enabled && Object.hasOwn(TILE_SOURCES, g.id));
const acctStatus = accountStatusJson(accountStatus(games, accountFeeds, riotLinks));
const steamShown = accountTiles.some((tile) => tile.key === 'steam' && tile.state === 'shown');
// a shown LoL or TFT card shows Riot's character art (Ezreal, Pengu): Riot's Legal Jibber Jabber notice
const riotCardShown = accountTiles.some((tile) => (tile.key === 'lol' || tile.key === 'tft') && tile.state === 'shown' && tile.art !== undefined);
const siteAchievements = availableAchievements(defs, soundAvailability());
// 내 게임 업적: the owner's records with their evidence screenshots (game-records.yaml order), each opening in the
// ImageViewer; their notices (riot-assets, blizzard) join the footer's.
// Collections do not promise insertion order: sort by the ids in game-records.yaml's own order.
const recordOrder = parseYamlList(recordsYaml, 'records').map((r) => r.id);
const recordData = (await getCollection('gameRecords')).map((e) => e.data).sort((a, b) => recordOrder.indexOf(a.id) - recordOrder.indexOf(b.id));
const records = await Promise.all(
  recordViews(recordData, games, lang, { tier: ui[lang]['gameRecords.tier'], rank: ui[lang]['gameRecords.rank'] }).map(async (view, i) => ({
    ...view,
    evidence: await evidence.build(recordData[i]),
  })),
);
// the showcase's art: the HoYoverse favourites plus the LoL/TFT stage art (whose Riot notice joins the footer's)
const showcaseArt = ['remielle', 'eula', 'mona', 'ezreal', 'pengu'] as const;
const shownNotices = new Set([...characters.notices(showcaseArt), ...(steamShown ? (['valve'] as const) : []), ...(riotCardShown ? (['riot-assets'] as const) : []), ...records.flatMap((r) => r.notices)]);
const notices = NOTICE_KEYS.filter((key) => shownNotices.has(key));
const credit = characterCredit(showcaseArt, lang);
const labels = {
  tablist: t(lang, 'favorites.tablist'),
  fetchedAt: t(lang, 'favorites.fetchedAt'),
  source: t(lang, 'favorites.source'),
  progress: t(lang, 'favorites.progress'),
};
---
<BaseLayout lang={lang} variant="game" title={meta.title} description={meta.description} page="player-log" section="player-log" sectionIndex notices={notices}>
  <Font cssVariable="--font-anton" slot="head" />
  <PageHeader lang={lang} variant="game" label="PLAYER LOG" title={t(lang, 'playerLog.title')} intro={t(lang, 'playerLog.intro')} />
  <MembershipRow
    lang={lang}
    membership={membershipCard(copy.membership, identity.headline)}
    tiles={tiles}
    tileSlots={games.reduce((n, g) => n + g.characters.filter((c) => !SHOWCASE_ONLY.includes(c.id)).length, 0)}
    achievements={siteAchievements}
  >
    {anyAccountEnabled && (
      <AccountLinks slot="accounts" client:idle lang={lang} tiles={accountTiles} labels={accountLinksLabels(lang)} relay={relayOrigin(process.env)} steamButton={steamButtonAvailable()} />
    )}
  </MembershipRow>
  <script is:inline type="application/json" id="acct-status" set:html={acctStatus} />
  {/* section#favorite-games (contract §5.14); unnamed wrapper, the island renders its own labelled section.fg inside */}
  <section id="favorite-games" class="pl-showcase">
    <div class="pl-showcase__inner">
      {/* client:visible: the island (and with it the showcase art, kept out of the server markup) starts when the showcase
          comes on screen, so the art never joins the page's first requests (Lighthouse; a 600px rootMargin was measured
          and still hydrated it with the first load on a phone) */}
      <FavoriteGames
        client:visible
        lang={lang}
        heading={{ caption: t(lang, 'section.favoriteGames'), title: t(lang, 'section.favoriteGames.title') }}
        games={showcase}
        accounts={{}}
        credit={credit}
        labels={labels}
      />
    </div>
  </section>
  <GameAchievements lang={lang} records={records} />
  <SiteAchievementList lang={lang} defs={siteAchievements} />
  <ImageViewer
    client:idle
    labels={{
      dialog: t(lang, 'modal.viewer'),
      close: t(lang, 'action.close'),
      previous: t(lang, 'viewer.previous'),
      next: t(lang, 'viewer.next'),
      counter: ui[lang]['viewer.counter'],
    }}
  />
</BaseLayout>

<style>
  .pl-showcase { padding-block: 0 var(--section-pad-y); background: var(--hud-bg); }
  .pl-showcase__inner { max-width: var(--container-hud); margin-inline: auto; }
  @media (min-width: 734px) { .pl-showcase__inner { padding-inline: var(--gutter); } }
</style>
