---
// Figures the case-study body does not cite inline (P1-7: a figure with `inlineAfter` sits right after the paragraph
// that first cites it; the rest keep their number here, after the body). Same centred reading column as the body.
import type { ImageMetadata } from 'astro';
import Figure from '../common/Figure.astro';
import SectionHead from '../hud/SectionHead.astro';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';

interface Props {
  lang: Lang;
  /** `number` is the figure's number in the case study ("그림 N"); defaults to the position in this list. */
  figures: { src: ImageMetadata; alt: string; caption: string; number?: number }[];
}

const { lang, figures } = Astro.props;
---

{
  figures.length > 0 && (
    <section id="figures" class="figs read read-section read-column" aria-labelledby="figures-title">
      <SectionHead id="figures-title" caption={t(lang, 'section.figures')} title={t(lang, 'project.figures')} />
      <ol class="figs__list" role="list">
        {figures.map((fig, i) => (
          <li>
            <Figure lang={lang} src={fig.src} alt={fig.alt} caption={fig.caption} number={fig.number ?? i + 1} class="figure--inline" />
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .figs { padding-block: 0 var(--section-pad-y); }
  .figs__list { margin-top: 20px; display: grid; } /* each .figure--inline carries its own 2em margins */
</style>
