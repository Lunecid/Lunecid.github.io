---
// INVENTORY: activities, certifications, languages and training in one light-HUD table (P1-9) instead of four card
// grids. Each kind is a row group (<tbody id="activities|certifications|languages|training">, the records anchors)
// headed by its name and a mono count; each row is the item (+ issuer/level/organiser) and its date on the right.
// `badge` is the expiry label (records.expired). Two columns only, so the table fits a 320px phone without scrolling.
import SectionHead from '../hud/SectionHead.astro';
import { metaSegments, type CredentialItem } from '../../lib/records';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { captionFor, getVariant, type VariantId } from '../../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  groups: { id: 'activities' | 'certifications' | 'languages' | 'training'; title: string; items: CredentialItem[] }[];
}

const { lang, variant, groups } = Astro.props;
const title = t(lang, 'records.inventory');
---
<section id="inventory" class:list={['rec', 'creds', variant === 'data' ? 'ed-sec' : 'read-sec']} aria-labelledby="inventory-title">
  <div class="container">
    <SectionHead variant={variant} id="inventory-title" caption={captionFor(getVariant(variant), 'inventory', lang)} title={title} />
    {variant === 'data' ? (
      <table class="ed-table creds-ed">
        <caption class="sr-only">{title}</caption>
        <colgroup><col /><col class="creds-ed__col-meta" /></colgroup>
        {groups.map((group) => (
          <tbody id={group.id} class="creds__group" data-group={group.id}>
            <tr>
              <th colspan="2" scope="rowgroup" class="creds-ed__group">{group.title}</th>
            </tr>
            {group.items.map((item) => (
              <tr>
                <td>
                  <p class="creds-ed__primary">{item.primary}{item.badge && <span class="ed-tag creds-ed__badge">{item.badge}</span>}{item.href && <a class="ed-link creds-ed__ev" href={item.href}>{t(lang, 'records.daconRecord')} <span aria-hidden="true">↗</span></a>}</p>
                  {item.secondary && <p class="ed-meta">{item.secondary}</p>}
                </td>
                <td class="creds-ed__meta num">{metaSegments(item).map((seg, i) => <Fragment>{i > 0 && ' · '}<span class="creds-ed__seg">{seg}</span></Fragment>)}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    ) : (
    <table class="creds__table lh-table">
      <caption class="sr-only">{title}</caption>
      {/* table-layout: fixed takes the widths from the columns (the first row is a colspan group head) */}
      <colgroup><col /><col class="creds__col-meta" /></colgroup>
      {groups.map((group) => (
        <tbody id={group.id} class="creds__group" data-group={group.id}>
          <tr class="creds__group-row">
            <th colspan="2" scope="rowgroup" class="creds__group-head">
              <span class="creds__group-title">{group.title}</span>
              <span class="creds__count tnum" aria-hidden="true">×{group.items.length}</span>
            </th>
          </tr>
          {group.items.map((item) => (
            <tr class="creds__item">
              <td class="creds__main">
                <p class="creds__primary">
                  {item.primary}
                  {item.badge && <span class="creds__badge lh-tag">{item.badge}</span>}
                  {item.href && (
                    <a class="creds__ev" href={item.href}>
                      {t(lang, 'records.daconRecord')}<span class="creds__ev-arrow" aria-hidden="true">↗</span>
                    </a>
                  )}
                </p>
                {item.secondary && <p class="creds__secondary">{item.secondary}</p>}
              </td>
              <td class="creds__meta">{metaSegments(item).map((seg, i) => <Fragment>{i > 0 && ' · '}<span class="creds__seg">{seg}</span></Fragment>)}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
    )}
  </div>
</section>

<style>
  .creds__table { margin-top: 24px; table-layout: fixed; border-top: 1px solid var(--read-line-strong); }
  .creds__group-head { padding-block: 18px 8px; border-bottom-color: var(--read-line-strong); }
  .creds__group:first-of-type .creds__group-head { padding-top: 12px; }
  .creds__group-title { font-size: var(--fs-label); font-weight: 800; letter-spacing: 0; color: var(--read-text); }
  .creds__count { margin-left: 8px; font: 600 var(--fs-label)/1.5 var(--font-mono); color: var(--read-muted); }
  .creds__col-meta { width: 128px; }
  .creds__primary { font-size: 16px; font-weight: 700; line-height: 1.5; color: var(--read-text); }
  .creds__badge { margin-left: 8px; vertical-align: 1px; color: var(--read-text); border-color: var(--read-text); }
  .creds__ev {
    display: inline-flex; align-items: center; gap: 0; min-height: var(--tap); margin-inline-start: .5em;
    font-size: var(--fs-caption); font-weight: 600; vertical-align: baseline;
  }
  .creds__ev-arrow { margin-inline-start: .25em; }
  .creds__secondary { margin-top: 2px; font-size: var(--fs-meta); line-height: 1.5; color: var(--read-muted); }
  .creds__meta { text-align: end; font: 500 var(--fs-caption)/1.6 var(--font-mono); color: var(--read-muted); font-variant-numeric: tabular-nums; }
  .creds__meta:lang(ko) { font-family: var(--font-sans); } /* "까지 유효", "시간": Hangul without mono spaces (P1-10) */
  @media (min-width: 734px) {
    .creds__col-meta { width: 240px; }
    .creds__meta { padding-top: 14px; }
    .creds__seg { white-space: nowrap; } /* F-059 (P-08): a date never splits inside a segment; cells stay cells below */
  }
  /* General version (P2-8) */
  .creds-ed { margin-top: 20px; table-layout: fixed; }
  .creds-ed__col-meta { width: 128px; }
  .creds-ed__group { padding-top: 18px; font-weight: 700; border-bottom: var(--ed-rule-w-strong) solid var(--ed-rule-strong); }
  .creds-ed__primary { font-weight: 700; }
  .creds-ed__badge { margin-left: 8px; }
  .creds-ed__meta { color: var(--ed-muted); font-variant-numeric: tabular-nums; }
  .creds-ed__ev { margin-left: 8px; font-weight: 600; }
  @media (min-width: 734px) {
    .creds-ed__col-meta { width: 240px; }
    .creds-ed__seg { white-space: nowrap; } /* F-059: a date never splits inside a segment */
  }
</style>
