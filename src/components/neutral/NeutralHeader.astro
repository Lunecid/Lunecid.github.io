---
// Neutral header (chooser, shared pages, 404): the name linking to the chooser (A-23) and the language switch (spec §6).
import { languages, type Lang } from '../../i18n/ui';
import { otherLang } from '../../i18n/utils';
import { chooserHref } from '../../lib/links';
import { NEUTRAL_IDENTITY } from '../../variants/neutral';

interface Props {
  lang: Lang;
  altLangHref: string | null;
  /** false on the chooser: no brand link. */
  brand?: boolean;
}
const { lang, altLangHref, brand = true } = Astro.props;
const other = otherLang(lang);
---
<header class="nt-header">
  <div class:list={['nt-header__bar', { 'nt-header__bar--lang-only': !brand }]}>
    {brand && <a class="nt-header__brand" href={chooserHref(lang)} data-nt-brand>{NEUTRAL_IDENTITY.siteTitle[lang]}</a>}
    {altLangHref !== null && (
      <p class="nt-header__lang"><a href={altLangHref} hreflang={other} lang={other} data-nt-lang>{languages[other]}</a></p>
    )}
  </div>
</header>
