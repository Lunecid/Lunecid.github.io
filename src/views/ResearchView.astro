---
// /research/ and /en/research/: PageHeader → #interests → #publications (year groups) → #in-progress → #for-labs.
import type { PageLayout } from '../layouts/page-layout';
import GhostArt from '../components/hud/GhostArt.astro';
import PageHeader from '../components/hud/PageHeader.astro';
import SectionHead from '../components/hud/SectionHead.astro';
import InterestCards from '../components/research/InterestCards.astro';
import InProgressList from '../components/research/InProgressList.astro';
import PublicationItem from '../components/research/PublicationItem.astro';
import ImageViewer from '../islands/ImageViewer';
import { researchPage } from '../data/research-page';
import { resolveFacts, resolveLocalizedDeep } from '../lib/facts';
import { getFactSource, getPerson, getPublications } from '../lib/portfolio';
import { toPaperCard } from '../lib/publications';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { t } from '../i18n/utils';
import { DOCUMENTS, SITE } from '../config';
import type { VariantId } from '../variants/ids';
import { captionFor, getVariant, pageMetaFor, resolveIdentity } from '../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

const { lang, variant, layout: Layout } = Astro.props;
const v = getVariant(variant);
const facts = await getFactSource();
const meta = pageMetaFor('research', lang, variant, facts);
const labNote = resolveIdentity(v, lang, facts).labNote;
const papers = (await getPublications()).map((entry) => toPaperCard(entry, { lang, variant }));
const years = [...new Set(papers.map((paper) => paper.year))].sort((a, b) => b - a);
const ids = (await getPerson()).researchIds;
---
<Layout lang={lang} variant={variant} title={meta.title} description={meta.description} page="research" section="research" sectionIndex>
  <PageHeader lang={lang} variant={variant} label={captionFor(v, 'pageResearch', lang)} title={t(lang, 'research.title')} intro={resolveFacts(researchPage.intro[lang], lang, facts)}>
    {/* D-7: professors reach the Academic CV from the research page header (and from #for-labs below). */}
    <p class="research-cv"><a class="btn btn--line cut cut--line" href={DOCUMENTS[v.documents.academic]} title={t(lang, 'nav.cvAcademic')} download>{t(lang, 'nav.cvAcademic')} <span aria-hidden="true">↓</span></a></p>
  </PageHeader>
  <InterestCards lang={lang} variant={variant} interests={resolveLocalizedDeep(researchPage.interests, facts)} />
  <section id="publications" class="pub__section read read-sec" aria-labelledby="publications-title">
    {getVariant(variant).modules.includes('characterArt') && <GhostArt side="left" />}
    <div class="container">
      <SectionHead variant={variant} id="publications-title" caption={captionFor(getVariant(variant), 'publications', lang)} title={t(lang, 'research.publications')} />
      {years.map((year) => (
        <div class="pub__year">
          <h3 class="pub__year-title tnum"><span class="lh-idx">{year}</span></h3>
          <ol class="pub__list" role="list">
            {papers.filter((paper) => paper.year === year).map((paper) => (
              <li><PublicationItem lang={lang} paper={paper} headingLevel={4} /></li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
  <InProgressList lang={lang} variant={variant} items={resolveLocalizedDeep(researchPage.ongoing, facts)} />
  <section id="for-labs" class="for-labs read read-sec" aria-labelledby="for-labs-title">
    <div class="container">
      {/* light HUD panel with corner marks, like [ NOW PLAYING ] (P1-9) */}
      <div class="for-labs__card lh-frame bracket bracket--sm">
        <SectionHead variant={variant} id="for-labs-title" caption={captionFor(getVariant(variant), 'forLabs', lang)} title={labNote.title} />
        <p class="for-labs__body">{labNote.body}</p>
        <ul class="for-labs__links lh-chips" role="list">
          <li><a class="lh-chip lh-chip--mono" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="lh-chip" href={DOCUMENTS[v.documents.academic]} title={t(lang, 'nav.cvAcademic')} download>{t(lang, 'nav.cvAcademic')} <span aria-hidden="true">↓</span></a></li>
          {ids.scholar && <li><a class="lh-chip" href={ids.scholar}>Google Scholar</a></li>}
          {ids.orcid && <li><a class="lh-chip" href={ids.orcid}>ORCID</a></li>}
        </ul>
      </div>
    </div>
  </section>
  <ImageViewer
    client:idle
    labels={{
      dialog: t(lang, 'modal.viewer'),
      close: t(lang, 'action.close'),
      previous: t(lang, 'viewer.previous'),
      next: t(lang, 'viewer.next'),
      counter: ui[lang]['viewer.counter'],
    }}
  />
</Layout>

<style>
  .research-cv { margin-top: 20px; }
  .pub__section { position: relative; overflow: hidden; }
  .pub__section > .container { position: relative; z-index: 1; }
  .pub__year { margin-top: 24px; padding-top: 8px; border-top: 1px solid var(--read-line-strong); }
  .pub__year-title { font-size: var(--fs-label); line-height: 1.5; }
  .pub__list { margin-top: 12px; display: grid; gap: 16px; }
  .for-labs { padding-bottom: 64px; }
  .for-labs__body { margin-top: 14px; font-size: 17px; line-height: 1.7; max-width: var(--measure); }
  .for-labs__body:lang(en) { line-height: 1.47; }
  .for-labs__links { margin-top: 18px; }
</style>
