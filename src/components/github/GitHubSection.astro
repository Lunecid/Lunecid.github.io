---
// GitHub repositories and the contribution calendar (spec §7 "GitHub (1차)"). Renders nothing unless the data is
// usable (not missing, not 'error', fresh). The stale-guard script hides the section in the browser once fetchedAt
// passes maxAgeDays after the deploy (spec §7.1).
// P1-17: one list (pinned first, then recent; excluded repositories dropped; the CoG code first; site-side
// descriptions from src/data/github-repos.ts so /en/ shows no Korean), star counts only above 0, and the list title
// before the profile link.
// P2-6: the general version draws editorial rows without the mono index, the calendar in black and grey, serif sub-heads
// and the profile as an underlined link with ↗; it never draws the ghost art (the gate below stays in the game branch).
import GhostArt from '../hud/GhostArt.astro';
import SectionHead from '../hud/SectionHead.astro';
import type { Lang } from '../../i18n/ui';
import { formatDate, formatNumber, t } from '../../i18n/utils';
import { usableGitHub, type GitHubData, type GitHubDay } from '../../lib/generated';
import { githubRepoList } from '../../lib/github';
import { captionFor, getVariant } from '../../variants';
import type { VariantId } from '../../variants/ids';

interface Props {
  lang: Lang;
  /** §1.8: the ghost art is game-only (characterArt); contract §4.4 keeps this prop for the P2 editorial markup. */
  variant: VariantId;
  data: GitHubData | undefined;
}

const { lang, variant, data } = Astro.props;
const gh = usableGitHub(data);

const CELL = 12;
const STEP = 15;
const KST_OFFSET_MS = 9 * 3_600_000; // Asia/Seoul has no DST

const repos = gh ? githubRepoList(gh, lang) : [];
const weeks: GitHubDay[][] = gh?.calendar ? gh.calendar.weeks.slice(-53) : [];
const calWidth = Math.max(weeks.length * STEP - (STEP - CELL), 0);
const calHeight = 7 * STEP - (STEP - CELL);
const weekday = (iso: string): number => new Date(`${iso}T00:00:00Z`).getUTCDay();
const totalLabel = gh?.calendar ? t(lang, 'github.contributionsTotal', { n: formatNumber(gh.calendar.total, lang) }) : '';
const asOfDay = gh ? new Date(Date.parse(gh.fetchedAt) + KST_OFFSET_MS).toISOString().slice(0, 10) : '';
/** "Python · 별 3"; a star count of 0 is left out (P1-17). */
const repoMeta = (language: string | null, stars: number): string =>
  [language, stars > 0 ? t(lang, 'github.stars', { n: formatNumber(stars, lang) }) : null]
    .filter((part): part is string => Boolean(part))
    .join(' · ');
---

{
  gh && (variant === 'game' ? (
    <section id="github" class="gh read read-sec" aria-labelledby="github-title" data-fetched-at={gh.fetchedAt} data-max-age-days={gh.maxAgeDays}>
      {getVariant(variant).modules.includes('characterArt') && <GhostArt side="left" />}
      <div class="container">
        <SectionHead variant={variant} id="github-title" caption={captionFor(getVariant(variant), 'github', lang)} title={t(lang, 'section.github.title')} />

        {repos.length > 0 && (
          <>
            <h3 class="gh__h">{t(lang, 'github.repos')}</h3>
            {/* light HUD rows (P1-9): index, mono repo name and description, language · stars on the right */}
            <ol class="gh__list lh-rows" role="list">
              {repos.map((r, i) => (
                <li class="gh__repo lh-row">
                  <span class="lh-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div class="gh__repo-body">
                    <a class="gh__name" href={r.url} lang="en">{r.name}</a>
                    {r.description && <p class="gh__desc">{r.description}</p>}
                  </div>
                  {repoMeta(r.language, r.stars) && <p class="gh__meta">{repoMeta(r.language, r.stars)}</p>}
                </li>
              ))}
            </ol>
          </>
        )}

        {gh.calendar && (
          <>
            <h3 class="gh__h">{t(lang, 'github.contributions')}</h3>
            <div class="gh__cal-frame lh-frame bracket bracket--sm">
              <p class="gh__total">{totalLabel}</p>
              <div class="gh__cal-scroll" tabindex="0" role="region" aria-label={t(lang, 'github.contributions')}>
                <svg class="gh__cal" viewBox={`0 0 ${calWidth} ${calHeight}`} width={calWidth} height={calHeight} role="img" aria-label={totalLabel}>
                  {weeks.flatMap((week, wi) =>
                    week.map((day) => (
                      <rect class={`gh__day gh__day--l${day.level}`} x={wi * STEP} y={weekday(day.date) * STEP} width={CELL} height={CELL}>
                        <title>{`${formatDate(day.date, lang)} · ${formatNumber(day.count, lang)}`}</title>
                      </rect>
                    )),
                  )}
                </svg>
              </div>
            </div>
          </>
        )}

        <ul class="gh__foot lh-chips" role="list">
          <li><a class="lh-chip" href={`https://github.com/${gh.login}`}>{`${t(lang, 'github.profile')} @${gh.login}`}</a></li>
        </ul>
        <p class="gh__asof">
          {`${t(lang, 'github.fetchedAt')} `}<time datetime={gh.fetchedAt}>{formatDate(asOfDay, lang)}</time>
        </p>
      </div>
    </section>
  ) : (
    <section id="github" class="gh ed-sec" aria-labelledby="github-title" data-fetched-at={gh.fetchedAt} data-max-age-days={gh.maxAgeDays}>
      <div class="container">
        <SectionHead variant={variant} id="github-title" caption={captionFor(getVariant(variant), 'github', lang)} title={t(lang, 'section.github.title')} />
        {repos.length > 0 && (
          <>
            <h3 class="gh__h" data-serif>{t(lang, 'github.repos')}</h3>
            <ol class="ed-list" role="list">
              {repos.map((r) => (
                <li class="ed-item gh-ed__repo">
                  <a class="gh-ed__name" href={r.url} lang="en">{r.name}</a>
                  {r.description && <p class="ed-body">{r.description}</p>}
                  {repoMeta(r.language, r.stars) && <p class="ed-meta">{repoMeta(r.language, r.stars)}</p>}
                </li>
              ))}
            </ol>
          </>
        )}
        {gh.calendar && (
          <>
            <h3 class="gh__h" data-serif>{t(lang, 'github.contributions')}</h3>
            <figure class="ed-figure gh-ed__cal">
              <p class="gh__total">{totalLabel}</p>
              <div class="gh__cal-scroll" tabindex="0" role="region" aria-label={t(lang, 'github.contributions')}>
                <svg class="gh__cal gh__cal--ed" viewBox={`0 0 ${calWidth} ${calHeight}`} width={calWidth} height={calHeight} role="img" aria-label={totalLabel}>
                  {weeks.flatMap((week, wi) =>
                    week.map((day) => (
                      <rect class={`gh__day gh__day--l${day.level}`} x={wi * STEP} y={weekday(day.date) * STEP} width={CELL} height={CELL}>
                        <title>{`${formatDate(day.date, lang)} · ${formatNumber(day.count, lang)}`}</title>
                      </rect>
                    )),
                  )}
                </svg>
              </div>
            </figure>
          </>
        )}
        <ul class="ed-links gh-ed__foot" role="list">
          <li><a class="ed-link" href={`https://github.com/${gh.login}`}>{`${t(lang, 'github.profile')} @${gh.login}`} <span aria-hidden="true">↗</span></a></li>
        </ul>
        <p class="ed-meta">{`${t(lang, 'github.fetchedAt')} `}<time datetime={gh.fetchedAt}>{formatDate(asOfDay, lang)}</time></p>
      </div>
    </section>
  ))
}

<script>
  import '../../scripts/stale-guard';
</script>

<style>
  .gh[hidden] { display: none; }
  .gh { position: relative; overflow: hidden; }
  .gh > .container { position: relative; z-index: 1; }
  .gh__h { margin-top: 32px; font-size: var(--fs-sub); font-weight: 700; line-height: var(--lh-sub); }
  .gh__list { margin-top: 12px; }
  .gh__repo { align-items: start; padding-block: 12px; }
  .gh__repo-body { min-width: 0; }
  /* Final fix 2 item 16: at least 44px wide ("TIL" was 28px), and positioned so the whole 44px box is on top of the
     description line it overlaps by the negative margin (that line used to take the lower 8px of every tap). */
  .gh__name { position: relative; display: inline-flex; align-items: center; min-height: var(--tap); min-width: var(--tap); margin-block: -8px; font: 700 15px/1.3 var(--font-mono); overflow-wrap: anywhere; }
  .gh__desc { margin-top: 2px; font-size: 15px; line-height: 1.5; color: var(--read-text); }
  .gh__meta { grid-column: 2; margin-top: 4px; font: 500 13px/1.5 var(--font-mono); color: var(--read-muted); }
  .gh__meta:lang(ko) { font-family: var(--font-sans); } /* "별 2": Hangul without mono spaces (P1-10) */
  .gh__cal-frame { margin-top: 12px; }
  .gh__total { font-size: 15px; }
  .gh__cal-scroll { margin-top: 10px; padding-bottom: 4px; overflow-x: auto; }
  .gh__cal { display: block; max-width: none; height: auto; }
  .gh__day--l0 { fill: var(--read-line); }
  .gh__day--l1 { fill: var(--accent-deep); fill-opacity: .3; }
  .gh__day--l2 { fill: var(--accent-deep); fill-opacity: .55; }
  .gh__day--l3 { fill: var(--accent-deep); fill-opacity: .8; }
  .gh__day--l4 { fill: var(--accent-deep); }
  .gh__foot { margin-top: 24px; }
  .gh__asof { margin-top: 8px; font: 500 13px/1.5 var(--font-mono); color: var(--read-muted); }
  .gh__asof:lang(ko) { font-family: var(--font-sans); }
  @media (min-width: 734px) {
    .gh__repo { grid-template-columns: 4.5em minmax(0, 1fr) auto; }
    .gh__meta { grid-column: 3; margin-top: 10px; text-align: end; white-space: nowrap; }
  }
  /* General version (P2-6): repo rows without the mono index; the calendar in black and grey. */
  .gh-ed__name { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; overflow-wrap: anywhere; }
  .gh-ed__cal { margin-top: 12px; }
  .gh-ed__foot { margin-top: 16px; }
  .gh__cal--ed .gh__day--l0 { fill: var(--ed-rule); }
  .gh__cal--ed .gh__day--l1 { fill: var(--ed-ink); fill-opacity: .3; }
  .gh__cal--ed .gh__day--l2 { fill: var(--ed-ink); fill-opacity: .55; }
  .gh__cal--ed .gh__day--l3 { fill: var(--ed-ink); fill-opacity: .8; }
  .gh__cal--ed .gh__day--l4 { fill: var(--ed-ink); fill-opacity: 1; }
</style>
