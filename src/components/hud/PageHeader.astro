---
/**
 * Header of every index page; it owns the page's only <h1>. Game version: the dark HUD header with the "[ ■ ] LABEL"
 * caption (D-8). General version (DS-3): the v5 page head (PageHeadData: label block, accent line, the English display
 * word, h1, lead; styled by editorial.css). Neutral pages (P2-4): caption + title + intro over a heavy rule, on the page
 * background. The default slot (optional) sits under the intro.
 */
import type { Lang } from '../../i18n/ui';
import type { PageVariant } from '../../variants';
import SectionLabel from './SectionLabel.astro';
import PageHeadData from '../data/PageHeadData.astro';

interface Props {
  variant: PageVariant;
  lang: Lang;
  label: string;
  title: string;
  intro?: string;
  /** General version: the Latin display words over the title (the English page title); default: the title. */
  display?: string;
}
const { variant, lang, label, title, intro, display } = Astro.props;
---
{variant === 'game' ? (
  <section class="page-head hud-grid" aria-labelledby="page-head-title">
    <div class="container container--hud page-head__inner">
      <SectionLabel variant="game" en={label} />
      <h1 id="page-head-title" class="page-head__title">{title}</h1>
      {intro && <p class="page-head__intro">{intro}</p>}
      <slot />
    </div>
  </section>
) : variant === 'data' ? (
  <section class="ed-phead" aria-labelledby="page-head-title">
    <div class="container">
      <PageHeadData lang={lang} caption={label} title={title} display={display ?? title} intro={intro}><slot /></PageHeadData>
    </div>
  </section>
) : (
  <section class="ed-page-head" aria-labelledby="page-head-title">
    <div class="container">
      <div class="ed-page-head__box">
        <SectionLabel variant={variant} en={label} />
        <h1 id="page-head-title" class="ed-page-head__title">{title}</h1>
        {intro && <p class="ed-page-head__intro">{intro}</p>}
        <slot />
      </div>
    </div>
  </section>
)}

<style>
  .page-head {
    padding-block: 48px 40px;
    border-bottom: 1px solid var(--hud-divider);
  }
  .page-head__title {
    margin-top: 12px;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    color: var(--hud-strong);
  }
  .page-head__intro {
    margin-top: 14px;
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--hud-muted);
  }
  /* General and neutral pages (P2-4) */
  .ed-page-head { padding-block: 40px 8px; background: var(--page-bg); color: var(--page-ink); }
  .ed-page-head__box { padding-bottom: 24px; border-bottom: var(--ed-rule-w-strong) solid var(--page-rule-strong); }
  .ed-page-head__title { margin-top: 8px; font-size: var(--fs-display); font-weight: 700; line-height: var(--lh-display); color: var(--page-ink); }
  .ed-page-head__intro { margin-top: 12px; max-width: var(--measure); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--page-muted); }
  @media (min-width: 1068px) {
    .page-head {
      padding-block: 64px 48px;
    }
    .ed-page-head { padding-block: 56px 8px; }
  }
  /* G-018 (owner decision 8 (a); fix-brief N02 step 5 leaves the .page-head part to P2-4): landscape phones get
     less spacing only; nothing is hidden. */
  @media (min-width: 734px) and (max-height: 500px) {
    .page-head { padding-block: 24px 20px; }
    .ed-page-head { padding-block: 20px 8px; }
    .page-head__title, .ed-page-head__title { font-size: min(var(--fs-display), 12svh); }
  }
</style>
