---
// /records/ and /en/records/ (spec §3 기록, §5.14 order). resume.yaml is the single source shared with the
// three PDFs, so GPA, dates and award names here equal the PDF text (Task 27 checks that).
import type { PageLayout } from '../layouts/page-layout';
import PageHeader from '../components/hud/PageHeader.astro';
import SectionHead from '../components/hud/SectionHead.astro';
import RecordsHead from '../components/records/RecordsHead.astro';
import EducationTimeline from '../components/records/EducationTimeline.astro';
import PublicationItem from '../components/research/PublicationItem.astro';
import ProjectSummaryList from '../components/records/ProjectSummaryList.astro';
import AwardList from '../components/records/AwardList.astro';
import CredentialList from '../components/records/CredentialList.astro';
import SkillList from '../components/records/SkillList.astro';
import JobFitTable from '../components/records/JobFitTable.astro';
import DocumentList from '../components/records/DocumentList.astro';
import ViewerMount from '../components/common/ViewerMount.astro';
import Folio from '../components/data/Folio.astro';
import StatTiles from '../components/data/StatTiles.astro';
import { dataRecordsCopy } from '../data/copy/data/records';
import { resolveDeep } from '../lib/facts';
import { buildCertificate } from '../lib/certificates';
import type { Certificate } from '../lib/certificates';
import { getAwards, getDocuments, getFactSource, getJobfit, getProjects, getPublications, getResume } from '../lib/portfolio';
import { projectSlug } from '../lib/projects';
import { toPaperCard } from '../lib/publications';
import { awardItems, credentialItems, projectSummaryItems, recordJumps, skillGroups, todayIso, type AwardCertMeta } from '../lib/records';
import { SITE } from '../config';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { CertificateId } from '../types';
import type { VariantId } from '../variants/ids';
import { captionFor, getVariant, pageMetaFor, resolveIdentity } from '../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

const { lang, variant, layout: Layout } = Astro.props;
const ctx = { lang, variant };
const v = getVariant(variant);
const facts = await getFactSource();
const identity = resolveIdentity(v, lang, facts);
// P2-8: the general version renders editorial markup (no light-HUD wrapper).
const editorial = v.theme === 'editorial';

const resume = await getResume();
const jobfit = await getJobfit(v.jobfit);

const awards = await getAwards();
const projects = await getProjects(lang);
const publications = await getPublications();

const papers = resume.publications.map(({ ref }) => {
  const entry = publications.find((publication) => publication.id === ref);
  if (!entry) throw new Error(`records: unknown publication ref "${ref}"`);
  return toPaperCard(entry, ctx);
});

const certificates = (await Promise.all(awards.map((award) => buildCertificate(award, lang)))).filter(
  (certificate): certificate is Certificate => certificate !== null,
);
const certMeta: Partial<Record<CertificateId, AwardCertMeta>> = Object.fromEntries(
  certificates.map((c) => [
    c.id,
    { href: c.fullSrc, width: c.width, height: c.height, srcSet: c.srcSet, sizes: c.sizes, alt: c.alt, caption: c.caption },
  ]),
);

const titles = {
  projects: Object.fromEntries(projects.map((project) => [projectSlug(project), project.data.title])),
  // Research evidence links to the paper page /research/<id>/, labelled with the publication's short title.
  stories: Object.fromEntries(
    publications.filter((entry) => entry.data.caseStudy).map((entry) => [entry.id, entry.data.shortTitle?.[lang] ?? entry.data.title]),
  ),
  // Code evidence (kind 'code'): the publication's public code link, e.g. "IEEE CoG 2026 논문 코드".
  codes: Object.fromEntries(
    publications.flatMap((entry) =>
      entry.data.code ? [[entry.id, { href: entry.data.code, label: t(lang, 'records.paperCode', { venue: entry.data.venueShort }) }]] : [],
    ),
  ),
};
const credentials = credentialItems(resume, lang, todayIso());
const skills = skillGroups(resume.skills, ctx, titles);
const all = await getDocuments();
const documents = v.documents.list.map((id) => {
  const d = all.find((x) => x.id === id);
  if (!d) throw new Error(`records: no document ${id}`);
  return { id: d.id, label: d.label[lang], href: d.href };
});
const meta = pageMetaFor('records', lang, variant, facts);
// DS-7 (v5): the general version's sidebar — the contents (the jump list, each with its target's section number: the
// page-wide section counter runs over the sections in this order), the 주요 기록 tiles (fact tokens) and the contacts.
const SECTION_ORDER = ['#profile', '#education', '#publications', '#projects', '#awards', '#inventory', '#skills', '#job-fit', '#documents'];
// The wrapper below is, on the general version, the CV grid: the sidebar (aside, the rail columns, sticky from 734 px)
// beside the sections, a folio between each two (written on the neighbouring lines so the game markup gains no
// whitespace).
const contents = recordJumps(lang).map((jump) => ({ ...jump, n: String(SECTION_ORDER.indexOf(jump.href) + 1).padStart(2, '0') }));
const sidebarStats = resolveDeep(dataRecordsCopy[lang].sidebarStats, lang, facts);
const researcherLinks = [
  resume.researchIds?.scholar ? { label: 'Google Scholar', href: resume.researchIds.scholar } : null,
  resume.researchIds?.orcid ? { label: 'ORCID', href: resume.researchIds.orcid } : null,
].filter((link): link is { label: string; href: string } => link !== null);
---
<Layout lang={lang} variant={variant} title={meta.title} description={meta.description} page="records" section="records" sectionIndex>
  <PageHeader lang={lang} variant={variant} label={captionFor(v, 'pageRecords', lang)} title={t(lang, 'records.title')} display={t('en', 'records.title')} />
  {/* P2-19: a short head (photo, name, status, one line, the three PDFs, an in-page bar), not the home profile again */}
  <RecordsHead
    lang={lang}
    variant={variant}
    name={resume.profile.name[lang]}
    headline={identity.headline}
    status={identity.status}
    tagline={identity.tagline}
    documents={documents}
    primary={v.documents.resume[lang]}
    contact={{ email: SITE.email, github: SITE.githubUrl, dacon: SITE.daconUrl }}
    ids={resume.researchIds}
  />
  {editorial && <div class="container"><Folio /></div>}<div class={editorial ? 'container ed-g ed-cv records-ed' : 'read'}>{editorial && (
      <aside class="ed-side" aria-label={t(lang, 'records.jump')}>
        <nav class="ed-toc" aria-label={t(lang, 'records.jump')}>
          <ol role="list">
            {contents.map((item) => <li><a href={item.href}>{item.label}<span class="ed-toc__n" aria-hidden="true">{item.n}</span></a></li>)}
          </ol>
        </nav>
        <p class="ed-side__h">{t(lang, 'hello.highlights')}</p>
        <StatTiles items={sidebarStats} tone="plain" />
        <ul class="ed-side__links" role="list">
          <li><a class="ed-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="ed-link" href={SITE.githubUrl}>GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a class="ed-link" href={SITE.daconUrl}>DACON <span aria-hidden="true">↗</span></a></li>
          {researcherLinks.map((link) => <li><a class="ed-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </aside>
    )}
    <EducationTimeline lang={lang} variant={variant} items={resume.education} />{editorial && <Folio />}
    <section id="publications" class:list={['rec', editorial ? 'ed-sec' : 'read-sec']} aria-labelledby="publications-title">
      <div class="container">
        <SectionHead variant={variant} id="publications-title" caption={captionFor(getVariant(variant), 'publications', lang)} title={t(lang, 'records.publications')} />
        <ol class="rec__pubs" role="list">
          {papers.map((paper) => (
            <li><PublicationItem variant={variant} lang={lang} paper={paper} headingLevel={3} compact /></li>
          ))}
        </ol>
      </div>
    </section>{editorial && <Folio />}
    <ProjectSummaryList lang={lang} variant={variant} items={projectSummaryItems(v.orders.recordsProjectsOrder.map((item) => ({ ref: item.slice('project:'.length) })), projects, ctx)} />{editorial && <Folio />}
    <AwardList lang={lang} variant={variant} awards={awardItems(resume.awards, awards, ctx, certMeta)} />{editorial && <Folio />}
    <CredentialList
      lang={lang}
      variant={variant}
      groups={[
        { id: 'activities', title: t(lang, 'records.activities'), items: credentials.activities },
        { id: 'certifications', title: t(lang, 'records.certifications'), items: credentials.certifications },
        { id: 'languages', title: t(lang, 'records.languages'), items: credentials.languages },
        { id: 'training', title: t(lang, 'records.training'), items: credentials.training },
      ]}
    />{editorial && <Folio />}
    <SkillList lang={lang} variant={variant} primary={skills.primary} familiar={skills.familiar} />{editorial && <Folio />}
    <JobFitTable lang={lang} variant={variant} data={jobfit} facts={facts} />{editorial && <Folio />}
    <DocumentList lang={lang} variant={variant} documents={documents} />
  </div>
  <ViewerMount lang={lang} />
</Layout>

<style>
  .rec__pubs { margin-top: 24px; display: grid; gap: 16px; }
</style>
