---
/** v4 .pcard: real ID photo + class line + qualitative tier badges (spec §5 플레이어 카드; no metrics). */
import { Image } from 'astro:assets';
import photo from '../../assets/photo/photo-id.webp';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  label: string;
  classLine: string;
  badges: string[];
  photoAlt: string;
}
const { lang, label, classLine, badges, photoAlt } = Astro.props;
---
<div class="player-card cut cut--line" role="group" aria-label={label}>
  <Image class="player-card__photo" src={photo} alt={photoAlt} width={46} densities={[1, 2]} loading="eager" />
  <div class="player-card__body">
    <p class="player-card__class" lang={lang}>{classLine}</p>
    <ul class="player-card__badges" role="list">
      {badges.map((badge) => <li class="badge badge--tier"><span aria-hidden="true">◆</span>{badge}</li>)}
    </ul>
  </div>
</div>

<style>
  .player-card {
    --c: var(--cut-panel);
    --cut-line: var(--hud-line);
    --cut-fill: var(--hud-panel);
    position: relative;
    z-index: 4;
    display: flex;
    gap: 12px;
    align-items: center;
    width: max-content;
    max-width: 100%;
    padding: 10px 14px 10px 10px;
  }
  .player-card :global(.player-card__photo) {
    width: 46px;
    height: 58px;
    object-fit: cover;
    object-position: 50% 18%;
    border: 1px solid var(--hud-line);
  }
  .player-card__class {
    font: 600 var(--fs-label)/1.4 var(--font-mono);
    letter-spacing: .1em;
    color: var(--hud-label);
  }
  .player-card__class:lang(ko) { font-family: var(--font-sans); letter-spacing: 0; }
  .player-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
</style>
