{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/en/game/",
        "http://localhost/game/projects/",
        "http://localhost/game/research/cog-2026-engagement/",
        "http://localhost/game/records/",
        "http://localhost/game/player-log/",
        "http://localhost/data/projects/",
        "http://localhost/data/projects/school-zone-blindspots/",
        "http://localhost/data/research/cog-2026-engagement/",
        "http://localhost/data/records/",
        "http://localhost/stats/",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci/reports-secondary" }
  }
}
