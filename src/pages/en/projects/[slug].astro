---
import type { GetStaticPaths } from 'astro';
import ProjectView from '../../../views/ProjectView.astro';
import { getProjects } from '../../../lib/portfolio';
import { hasProjectPage, projectSlug } from '../../../lib/projects';
// Old route (deleted in P1-11, replaced by src/pages/[variant]/projects/[slug].astro + variantProjectPaths).
export const getStaticPaths = (async () =>
  (await getProjects('en')).filter((e) => hasProjectPage(e.data)).map((entry) => ({ params: { slug: projectSlug(entry) }, props: { entry } }))) satisfies GetStaticPaths;
---

<ProjectView lang="en" entry={Astro.props.entry} />
