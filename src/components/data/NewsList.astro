---
// The general home's news (spec §10.2 item 4): the entries of the game's PATCH NOTES (toPatchNotes) as a plain dated
// list — no version tag, pointer or HUD chip. The section id stays #patch-notes (one skeleton, §5.3).
import SectionHead from '../hud/SectionHead.astro';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import type { PatchNoteItem } from '../../lib/news';
import { captionFor, getVariant } from '../../variants';

interface Props {
  lang: Lang;
  notes: PatchNoteItem[];
}
const { lang, notes } = Astro.props;
---
<section id="patch-notes" class="news ed-sec" aria-labelledby="pn-title">
  <div class="container">
    <SectionHead variant="data" id="pn-title" caption={captionFor(getVariant('data'), 'patchNotes', lang)} title={t(lang, 'section.patchNotes.title')} />
    <ol class="ed-list" role="list">
      {notes.map((note) => (
        <li class="ed-item news__item">
          <p class="ed-meta"><time datetime={note.dateIso}>{note.dateLabel}</time> · {note.kindLabel}</p>
          <p class="news__title">{note.href ? <a class="hit" href={note.href}>{note.short ?? note.text}</a> : (note.short ?? note.text)}</p>
          {note.short && <p class="ed-body">{note.text}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .news__title { margin-top: 2px; font-weight: 700; }
</style>
