---
// Skills without proficiency bars (spec §9.1) as one two-column light-HUD table (P1-9): "skill | evidence chips",
// primary and "also used" as row groups. Each chip links the evidence, labelled by the project title or the paper's
// short title in the page language (kind 'code' → the paper's public code).
import SectionHead from '../hud/SectionHead.astro';
import type { SkillItem } from '../../lib/records';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { captionFor, getVariant, type VariantId } from '../../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  primary: SkillItem[];
  familiar: SkillItem[];
}

const { lang, variant, primary, familiar } = Astro.props;
const groups = [
  { key: 'primary', title: t(lang, 'records.skillsPrimary'), items: primary },
  { key: 'familiar', title: t(lang, 'records.skillsFamiliar'), items: familiar },
].filter((group) => group.items.length > 0);
const title = t(lang, 'records.skills');
---
<section id="skills" class:list={['rec', variant === 'data' ? 'ed-sec' : 'read-sec']} aria-labelledby="skills-title">
  <div class="container">
    <SectionHead variant={variant} id="skills-title" caption={captionFor(getVariant(variant), 'skills', lang)} title={title} />
    {variant === 'data' ? (
      <table class="ed-table skills-ed">
        <caption class="sr-only">{title}</caption>
        <colgroup><col class="skills-ed__col-name" /><col /></colgroup>
        <thead>
          <tr><th scope="col">{title}</th><th scope="col">{t(lang, 'records.evidence')}</th></tr>
        </thead>
        {groups.map((group) => (
          <tbody data-group={group.key}>
            <tr><th colspan="2" scope="rowgroup" class="skills-ed__group">{group.title}</th></tr>
            {group.items.map((skill) => (
              <tr>
                <th scope="row" lang="en">{skill.name}</th>
                <td>
                  <ul class="ed-links" role="list">
                    {skill.evidence.map((e) => <li><a class="ed-link" href={e.href}>{e.label}{e.href.startsWith('http') && <Fragment> <span aria-hidden="true">↗</span></Fragment>}</a></li>)}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    ) : (
    <table class="skills__table lh-table">
      <caption class="sr-only">{title}</caption>
      <colgroup><col class="skills__col-name" /><col /></colgroup>
      <thead>
        <tr><th scope="col">{title}</th><th scope="col">{t(lang, 'records.evidence')}</th></tr>
      </thead>
      {groups.map((group) => (
        <tbody class="skills__group" data-group={group.key}>
          <tr><th colspan="2" scope="rowgroup" class="skills__group-title">{group.title}</th></tr>
          {group.items.map((skill) => (
            <tr class="skills__item">
              <th scope="row" class="skills__name" lang="en">{skill.name}</th>
              <td class="skills__evidence">
                <ul class="skills__links lh-chips" role="list">
                  {skill.evidence.map((e) => <li><a class="lh-chip" href={e.href}>{e.label}{e.href.startsWith('http') && <Fragment> <span aria-hidden="true">↗</span></Fragment>}</a></li>)}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
    )}
  </div>
</section>

<style>
  .skills__table { margin-top: 24px; table-layout: fixed; }
  .skills__col-name { width: 112px; }
  .skills__group-title { padding-block: 18px 8px; font-size: var(--fs-label); font-weight: 800; color: var(--read-text); border-bottom-color: var(--read-line-strong); }
  .skills__name { padding-top: 18px; font: 700 var(--fs-meta)/1.4 var(--font-mono); color: var(--read-text); overflow-wrap: anywhere; }
  .skills__evidence { padding-block: 10px; }
  @media (min-width: 734px) {
    .skills__col-name { width: 220px; }
    .skills__name { font-size: var(--fs-small); }
  }
  /* General version (P2-8) */
  .skills-ed { margin-top: 20px; table-layout: fixed; }
  .skills-ed__col-name { width: 34%; }
  .skills-ed__group { padding-top: 18px; font-weight: 700; }
  @media (min-width: 734px) { .skills-ed__col-name { width: 22%; } }
</style>
