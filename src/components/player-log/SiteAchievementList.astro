---
import SectionHead from '../hud/SectionHead.astro';
import { ui, type Lang } from '../../i18n/ui';
import { hangulRuns, t } from '../../i18n/utils';
import type { AchievementDef } from '../../lib/achievements';

interface Props {
  lang: Lang;
  defs: AchievementDef[];
}
const { lang, defs } = Astro.props;
// Final review fix 1 item 20: Hangul inside English copy (e.g. the "한국어" menu label in a hint) gets lang="ko";
// the template renders these runs (a Hangul run as <span lang="ko">).
const runs = (text: string) => hangulRuns(text, lang);
// Raw template ('{n} / {total} 달성'): the client script fills it; t() renders the SSR value only.
const progressTemplate = ui[lang]['achievement.progress'];
---
<section id="site-achievements" class="site-ach read read-sec" aria-labelledby="site-ach-title" data-site-ach>
  <div class="container">
    <SectionHead id="site-ach-title" caption={t(lang, 'section.siteAchievements')} title={t(lang, 'section.siteAchievements.title')} />
    <p class="site-ach__progress tnum" data-ach-progress data-template={progressTemplate}>{t(lang, 'achievement.progress', { n: 0, total: defs.length })}</p>
    {/* light HUD rows (P1-9): a square star slot (gold once unlocked), title and text, the state as a square tag */}
    <ol class="site-ach__list" role="list">
      {defs.map((d) => (
        <li class="site-ach__item" data-ach-id={d.id} data-unlocked="false">
          <span class="site-ach__icon" aria-hidden="true">★</span>
          <div class="site-ach__body">
            {/* P-02 (F-087): a hidden title reads as the sr-only sentence, not as a heading named '???'; reveal() replaces both spans. */}
            <h3 class="site-ach__title" data-ach-slot="title">{d.hidden ? <Fragment><span aria-hidden="true">{t(lang, 'achievement.hiddenTitle')}</span><span class="sr-only">{t(lang, 'achievement.hiddenTitleSr')}</span></Fragment> : d.title[lang]}</h3>
            <p class:list={['site-ach__desc', { 'site-ach__desc--hint': d.hidden }]} data-ach-slot="desc">{runs(d.hidden ? d.hint[lang] : d.description[lang]).map((r) => (r.ko ? <span lang="ko">{r.text}</span> : r.text))}</p>
            {!d.hidden && <p class="site-ach__hint">{runs(d.hint[lang]).map((r) => (r.ko ? <span lang="ko">{r.text}</span> : r.text))}</p>}
            {d.hidden && <template data-ach-real><span data-ach-title>{d.title[lang]}</span><span data-ach-desc>{d.description[lang]}</span></template>}
          </div>
          <p class="site-ach__state">
            {d.hidden && <span class="site-ach__tag lh-tag">{t(lang, 'achievement.hidden')}</span>}
            <span class="site-ach__state-tag lh-tag" data-ach-state="locked">{t(lang, 'achievement.locked')}</span>
            <span class="site-ach__state-tag site-ach__state-tag--on lh-tag" data-ach-state="unlocked" hidden>{t(lang, 'achievement.unlocked')}</span>
          </p>
        </li>
      ))}
    </ol>
    {/* P-02 (F-091): without JS nothing is recorded, so base.css hides the progress, hints and note and shows this line instead. */}
    <p class="site-ach__nojs">{t(lang, 'achievement.noJs')}</p>
    <p class="site-ach__note" data-ach-note data-blocked-text={t(lang, 'achievement.storageBlocked')}>{t(lang, 'achievement.storageNote')}</p>
  </div>
</section>

<script>
  import { isStorageBlocked, readUnlocked, STORAGE_BLOCKED_EVENT, UNLOCK_EVENT } from '../../lib/achievements';

  const root = document.querySelector<HTMLElement>('[data-site-ach]');
  if (root) {
    const progress = root.querySelector<HTMLElement>('[data-ach-progress]');
    const template = progress?.dataset.template ?? '';
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-ach-id]'));

    const reveal = (li: HTMLLIElement) => {
      li.dataset.unlocked = 'true';
      const real = li.querySelector<HTMLTemplateElement>('template[data-ach-real]');
      if (real) {
        const title = real.content.querySelector('[data-ach-title]')?.textContent ?? '';
        const desc = real.content.querySelector('[data-ach-desc]')?.textContent ?? '';
        const titleSlot = li.querySelector('[data-ach-slot="title"]');
        const descSlot = li.querySelector('[data-ach-slot="desc"]');
        if (titleSlot) titleSlot.textContent = title;
        if (descSlot) descSlot.textContent = desc;
      }
      li.querySelector('.site-ach__hint')?.setAttribute('hidden', '');
      li.querySelector('[data-ach-state="locked"]')?.setAttribute('hidden', '');
      li.querySelector('[data-ach-state="unlocked"]')?.removeAttribute('hidden');
    };

    // readUnlocked() already tolerates throwing storage (in-memory fallback).
    const sync = () => {
      const unlocked = readUnlocked();
      let n = 0;
      for (const li of items) {
        const id = li.dataset.achId;
        if (!id || !(id in unlocked)) continue;
        n += 1;
        if (li.dataset.unlocked !== 'true') reveal(li);
      }
      if (progress && template) progress.textContent = template.replace('{n}', String(n)).replace('{total}', String(items.length));
    };

    // P-02 (F-091): once a write to the shared store threw, say that progress lasts only on this page.
    const note = root.querySelector<HTMLElement>('[data-ach-note]');
    const showBlocked = () => {
      const text = note?.dataset.blockedText;
      if (note && text && isStorageBlocked()) note.textContent = text;
    };

    sync();
    showBlocked();
    window.addEventListener(UNLOCK_EVENT, sync);
    window.addEventListener(STORAGE_BLOCKED_EVENT, showBlocked);
  }
</script>

<style>
  .site-ach__progress { margin-top: 16px; font: 700 15px/1.4 var(--font-mono); color: var(--read-text); }
  .site-ach__progress:lang(ko) { font-family: var(--font-sans); } /* "0 / 7 달성" */
  /* Shared list packing: align-content:start so state tags stay 24px (F-055); game lists reuse the same idea. */
  .site-ach__list { margin-top: 16px; padding: 0; list-style: none; border-top: 1px solid var(--read-line-strong); }
  @media (min-width: 734px) {
    .site-ach__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; align-content: start; }
  }
  .site-ach__item {
    display: grid; grid-template-columns: 32px minmax(0, 1fr); grid-template-areas: "icon body" "icon state"; gap: 4px 14px;
    align-content: start;
    padding-block: 16px; border-bottom: 1px solid var(--read-line);
  }
  .site-ach__icon {
    grid-area: icon; width: 32px; height: 32px; display: grid; place-items: center;
    border: 1px solid var(--read-line-strong); background: var(--read-card); color: var(--read-muted); font-size: 16px;
  }
  .site-ach__item[data-unlocked="true"] .site-ach__icon { background: var(--gold); border-color: var(--gold); color: var(--gold-ink); }
  .site-ach__body { grid-area: body; min-width: 0; }
  .site-ach__title { font-size: 17px; font-weight: 700; line-height: 1.4; color: var(--read-text); }
  .site-ach__desc { margin-top: 2px; font-size: 15px; color: var(--read-text); }
  .site-ach__hint { margin-top: 2px; font-size: 14px; color: var(--read-muted); }
  .site-ach__state { grid-area: state; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px; margin-top: 4px; }
  /* F-055 height + flex align, but not on [hidden] — author display would beat the UA [hidden] { display: none }. */
  .site-ach__state-tag:not([hidden]) { height: 24px; box-sizing: border-box; display: inline-flex; align-items: center; }
  .site-ach__state-tag[hidden] { display: none; }
  .site-ach__state-tag--on { color: var(--gold-ink); background: var(--gold); border-color: var(--gold); }
  .site-ach__note, .site-ach__nojs { margin-top: 14px; font-size: 14px; color: var(--read-muted); }
</style>
