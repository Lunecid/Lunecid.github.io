---
// src/pages/[variant]/index.astro
import type { GetStaticPaths } from 'astro';
import HomeView from '../../views/HomeView.astro';
import { variantParamsFor } from '../../lib/routes';
import { BASE_PATH, type VariantId } from '../../variants/ids';
export const getStaticPaths = (() => variantParamsFor(BASE_PATH.home)) satisfies GetStaticPaths;
const variant = Astro.params.variant as VariantId;
---
<HomeView lang="ko" variant={variant} />
