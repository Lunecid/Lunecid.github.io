---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/hud.css';
import '../styles/read.css';
import { getCollection } from 'astro:content';
import { ACADEMIC_CV_HREF, CV_HREF, GOATCOUNTER, SITE } from '../config';
import type { NavSection, NoticeKey, PageId } from '../types';
import type { Lang } from '../i18n/ui';
import { otherLang, switchLocalePath, t } from '../i18n/utils';
import { FONT_URL, fontFaceCss } from '../lib/fonts';
import { HEAD_INIT_SCRIPT } from '../lib/head-init';
import { VIEWER_QUEUE_SCRIPT } from '../lib/viewer-queue';
import { alternateLinks, canonicalUrl, ogSlugFor } from '../lib/seo';
import { goatcounterScript } from '../lib/analytics';
import { goatcounterSelfHosted, soundAvailability } from '../lib/public-assets';
import { availableAchievements, type AchievementDef } from '../lib/achievements';
import HudNav from '../components/hud/HudNav.astro';
import SiteFooter from '../components/hud/SiteFooter.astro';
import CrtIntro from '../components/hud/CrtIntro.astro';
import AchievementHost from '../islands/AchievementHost';
import { getVariant } from '../variants';
import type { ModuleId, VariantId } from '../variants/ids';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: PageId;
  section?: NavSection;
  sectionIndex?: boolean;
  ogSlug?: string;
  noindex?: boolean;
  notices?: NoticeKey[];
  altLangHref?: string | null;
  jsonLd?: Record<string, unknown>;
  variant: VariantId;
}

const {
  lang,
  title,
  description,
  page,
  section,
  sectionIndex = false,
  ogSlug,
  noindex = false,
  notices = [],
  altLangHref,
  jsonLd,
  variant,
} = Astro.props;
const v = getVariant(variant);
const on = (m: ModuleId): boolean => v.modules.includes(m);

const pathname = Astro.url.pathname;
const altHref = altLangHref === undefined ? switchLocalePath(pathname, otherLang(lang)) : altLangHref;
const canonical = canonicalUrl(pathname);
const ogImage = `${SITE.url}/og/${ogSlug ?? ogSlugFor(pathname)}.png`;
const sound = soundAvailability();
const bgm = sound.bgm && on('bgm');
const sfx = sound.sfx && on('sfx');
// D-7: on the research pages (/research/, the paper page, /en/ mirrors) the nav CV button opens the Academic CV;
// everywhere else the résumé in the page language.
const cv =
  section === 'research'
    ? { href: ACADEMIC_CV_HREF, label: t(lang, 'nav.cvAcademic') }
    : { href: CV_HREF[lang], label: t(lang, 'nav.cvResume') };
const goatcounter = import.meta.env.PROD ? goatcounterScript(GOATCOUNTER.code, goatcounterSelfHosted()) : null;
const defs: AchievementDef[] = on('achievements') ? availableAchievements((await getCollection('achievements')).map((e) => e.data), { bgm }) : [];
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const achievementLabels = {
  region: t(lang, 'achievement.region'),
  close: t(lang, 'achievement.dismiss'),
};
---
<!doctype html>
<html lang={lang} data-variant={variant} data-page={page} data-section={section} data-motion="full" data-sfx={sfx ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={HEAD_INIT_SCRIPT} />
    <script is:inline set:html={VIEWER_QUEUE_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {altHref !== null && alternateLinks(pathname).map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={v.identity.siteTitle[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* final fix 2 item 21: raster fallbacks built from the SVG (src/lib/favicon.ts). sizes="32x32" keeps browsers
        that read SVG icons on the SVG; the apple-touch-icon is what iOS puts on the home screen. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Page fonts (src/lib/fonts.ts): `astro build` replaces these placeholders with the sans subsets and the mono
        file (scripts/fonts/build.mjs). Both are preloaded: every page shows text in both above the fold, and the
        preloads measured better on mobile Lighthouse than the mono preload alone or none (batch 2 report). */}
    <style is:inline set:html={fontFaceCss(['sans', 'mono'])}></style>
    <link rel="preload" href={FONT_URL.mono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONT_URL.sans} as="font" type="font/woff2" crossorigin />
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
    {goatcounter && (
      <script
        is:inline
        async
        src={goatcounter.src}
        data-goatcounter={goatcounter['data-goatcounter']}
        integrity={goatcounter.integrity}
        crossorigin={goatcounter.crossorigin}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'site.skipToContent')}</a>
    {page === 'home' && on('crtIntro') && <CrtIntro />}
    <HudNav lang={lang} variant={variant} current={section} exact={sectionIndex} altLangHref={altHref} cvHref={cv.href} cvLabel={cv.label} bgmAvailable={bgm} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter lang={lang} notices={notices} builtAt={new Date()} />
    {on('achievements') && <AchievementHost client:idle lang={lang} defs={defs} labels={achievementLabels} />}
  </body>
</html>
