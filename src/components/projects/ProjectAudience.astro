---
// "게임 팀에게 | 연구 기여" / "For game teams | Research contribution" after a case-study body (spec §3 case-study
// order, §6 audience{game, research}; P1-8). Two light-HUD panels (square, corner marks, "[ ■ ] CAPTION" over the
// title, P1-9) on the light reading band, in the same centred text column as the body above.
// P2-6: the general version draws plain blocks under a heavy rule with serif labels (the for-game-teams block never
// reaches a general page, P1-9).
import SectionLabel from '../hud/SectionLabel.astro';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { captionFor, getVariant, type VariantId } from '../../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  /** Only the parts present are rendered (a page may have only one of the two). */
  audience: { game?: string; research?: string };
}

const { lang, variant, audience } = Astro.props;
const blocks = [
  { id: 'for-game-teams', caption: t(lang, 'section.forGameTeams'), label: t(lang, 'project.forGameTeams'), text: audience.game },
  { id: 'research-contribution', caption: captionFor(getVariant(variant), 'researchContribution', lang), label: t(lang, 'project.researchContribution'), text: audience.research },
].filter((block): block is { id: string; caption: string; label: string; text: string } => typeof block.text === 'string' && block.text.trim() !== '');
---
{blocks.length > 0 && (variant === 'game' ? (
<div class="audience read read-column">
  <div class:list={['audience__grid', { 'audience__grid--single': blocks.length === 1 }]}>
    {blocks.map((block) => (
      <section id={block.id} class="audience__block lh-frame bracket bracket--sm" aria-labelledby={`${block.id}-title`}>
        <SectionLabel variant="game" en={block.caption} />
        <h2 id={`${block.id}-title`} class="audience__label">{block.label}</h2>
        <p class="audience__text">{block.text}</p>
      </section>
    ))}
  </div>
</div>
) : (
<div class="ed-prose audience-ed">
  {blocks.map((block) => (
    <section id={block.id} class="audience-ed__block" aria-labelledby={`${block.id}-title`}>
      <SectionLabel variant={variant} en={block.caption} />
      <h2 id={`${block.id}-title`} class="ed-item__title" data-serif>{block.label}</h2>
      <p class="ed-body">{block.text}</p>
    </section>
  ))}
</div>
))}

<style>
  /* The centred reading column comes from .read-column (read.css), shared with the body above. */
  .audience { padding-block: 0 var(--section-pad-y); }
  .audience__grid { display: grid; gap: 12px; }
  .audience__block { min-width: 0; }
  .audience__label { margin-top: 6px; font-size: var(--fs-sub); font-weight: 800; line-height: var(--lh-sub); color: var(--read-text); }
  .audience__text { margin-top: 8px; font-size: 16px; line-height: 1.7; color: var(--read-text); }
  .audience__text:lang(en) { line-height: 1.5; }
  @media (min-width: 734px) {
    .audience__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .audience__grid--single { grid-template-columns: minmax(0, 1fr); }
  }
  /* F-040 / decision 9 (b): at ≥1068px widen beyond the reading column so each card is ≥34em; keep 2 columns. */
  @media (min-width: 1068px) {
    .audience {
      max-width: var(--container-hud);
      margin-inline: auto;
      padding-inline: var(--gutter);
      box-sizing: border-box;
    }
    .audience__grid { align-items: start; }
  }
  .audience-ed { display: grid; gap: 28px; }
  .audience-ed__block { display: grid; gap: 6px; padding-top: 10px; border-top: var(--ed-rule-w-strong) solid var(--ed-rule-strong); }
</style>
