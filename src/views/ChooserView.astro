---
// The chooser (motion plan amendment 2026-10-05; chooser v6.4, owner-approved): a dark HUD page holding a desk with two
// files — the game version's cyber cover behind, the general version's white art-paper printout tilted on top of it
// (data in front at rest, so the DOM and Tab order run data → game). No visible heading: the name is a visually hidden
// h1 (the page keeps its heading and title); the small archive caption stays at the top left and the desk is centred in
// the height below it. Each file is one link. Keyboard and memory: src/scripts/chooser.ts. The pre-paint redirect
// (P1-14) runs from the head (headScript="chooser").
import NeutralLayout from '../layouts/NeutralLayout.astro';
// The page, desk and cover styles ship as ONE external, content-hashed stylesheet that only the chooser links (the
// HTML stays within the first flight; the textures are cached): src/styles/chooser.css.
import chooserCss from '../styles/chooser.css?url';
import GameCover from '../components/neutral/GameCover.astro';
import PrintoutCover from '../components/neutral/PrintoutCover.astro';
import { coverCopy } from '../data/copy/chooser-covers';
import type { Lang } from '../i18n/ui';
import { buildCover, COVER_ORDER } from '../lib/chooser-covers';
import { fontFaceCss } from '../lib/fonts';
import { chooserHref } from '../lib/links';
import { getFactSource, getPerson } from '../lib/portfolio';
import { todayIso } from '../lib/records';
import { canonicalUrl, personJsonLd } from '../lib/seo';
import { NEUTRAL_IDENTITY, pageMetaFor } from '../variants';
import { VARIANT_IDS } from '../variants/ids';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const facts = await getFactSource();
const person = await getPerson();
const meta = pageMetaFor('chooser', lang, null, facts);
const today = todayIso(new Date());
const mast = coverCopy[lang].mast;
const touch = coverCopy[lang].touch; // the touch hint (chooser.ts fills it on touch screens only)
const sound = coverCopy[lang].sound; // the mute button for the page-turn sound (chooser.ts shows it)
const files = mast.files.replace('{n}', String(VARIANT_IDS.length).padStart(2, '0'));
const covers = COVER_ORDER.map((id) => buildCover(id, lang, today));
---
<NeutralLayout
  lang={lang}
  title={meta.title}
  description={meta.description}
  page="chooser"
  headScript="chooser"
  analytics="unless-redirecting"
  header="lang-only"
  jsonLd={personJsonLd(lang, { jobTitle: NEUTRAL_IDENTITY.headline[lang], url: canonicalUrl(chooserHref(lang)) }, person.researchIds)}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={chooserCss} />
    <style is:inline set:html={fontFaceCss(['coverMono', 'coverDisplay', 'coverBanner'])}></style>
  </Fragment>
  <section class="chooser" aria-labelledby="chooser-name">
    <div class="chooser__stage">
      <div class="chooser__mast">
        <p class="chooser__cap" lang="en"><span class="chooser__mark" aria-hidden="true">[<i class="chooser__sq"></i>]</span><span>{mast.label}</span><span>{files}</span></p>
        <h1 id="chooser-name" class="sr-only">{person.name[lang]}</h1>
        <button type="button" class="chooser__sound" data-sound-toggle aria-pressed="true" data-on={sound.on} data-off={sound.off} hidden><span class="chooser__sound-l">{sound.label}</span> <span class="chooser__sound-s">{sound.on}</span></button>
      </div>
      <div class="desk" data-chooser data-desk>
        <div class="props" aria-hidden="true"><i class="mat"></i></div>
        {covers.map((cover) => (cover.id === 'data' ? <PrintoutCover cover={cover} /> : <GameCover cover={cover} />))}
      </div>
      <p class="desk__hint" aria-live="polite" data-rest={touch.rest} data-aside={touch.aside}></p>
      <div class="xnav" aria-hidden="true"><i class="xnav__bg"></i><i class="xnav__ln"></i></div>
    </div>
  </section>
</NeutralLayout>

<script>
  import { initChooser } from '../scripts/chooser';
  initChooser();
</script>
