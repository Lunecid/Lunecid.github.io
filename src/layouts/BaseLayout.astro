---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/hud.css';
import '../styles/read.css';
// The game palette's rules (palette v4): one external, content-hashed sheet only game pages link (the data sheet's
// precedent); its selectors carry the :root[data-variant="game"] prefix, so they win over the inlined component styles.
import gameCss from '../styles/game.css?url';
import { getCollection } from 'astro:content';
import { DOCUMENTS } from '../config';
import type { NavSection, NoticeKey, PageId } from '../types';
import type { Lang } from '../i18n/ui';
import { otherLang, switchLocalePath, t } from '../i18n/utils';
import { FONT_URL, fontFaceCss } from '../lib/fonts';
import { HEAD_INIT_SCRIPT } from '../lib/head-init';
import { parseRoute } from '../lib/routes';
import { VIEWER_QUEUE_SCRIPT } from '../lib/viewer-queue';
import { soundAvailability } from '../lib/public-assets';
import { availableAchievements, type AchievementDef } from '../lib/achievements';
import HudNav from '../components/hud/HudNav.astro';
import SiteFooter from '../components/hud/SiteFooter.astro';
import CrtIntro from '../components/hud/CrtIntro.astro';
import AchievementHost from '../components/hud/AchievementHost.astro';
import EdgeFrame from '../components/hud/EdgeFrame.astro';
import HeadMeta from './partials/HeadMeta.astro';
import { getVariant } from '../variants';
import type { ModuleId, VariantId } from '../variants/ids';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: PageId;
  section?: NavSection;
  sectionIndex?: boolean;
  ogSlug?: string;
  noindex?: boolean;
  notices?: NoticeKey[];
  altLangHref?: string | null;
  jsonLd?: Record<string, unknown>;
  variant: VariantId;
}

const {
  lang,
  title,
  description,
  page,
  section,
  sectionIndex = false,
  ogSlug,
  noindex = false,
  notices = [],
  altLangHref,
  jsonLd,
  variant,
} = Astro.props;
const v = getVariant(variant);
const on = (m: ModuleId): boolean => v.modules.includes(m);

const pathname = Astro.url.pathname;
const route = parseRoute(Astro.url.pathname);
const altHref = altLangHref === undefined ? switchLocalePath(pathname, otherLang(lang)) : altLangHref;
const sound = soundAvailability();
const bgm = sound.bgm && on('bgm');
const sfx = sound.sfx && on('sfx');
// D-7: on the research pages (/research/, the paper page, /en/ mirrors) the nav CV button opens the Academic CV;
// everywhere else the résumé in the page language.
const cv =
  section === 'research'
    ? { href: DOCUMENTS[v.documents.academic], label: t(lang, 'nav.cvAcademic') }
    : { href: DOCUMENTS[v.documents.resume[lang]], label: t(lang, 'nav.cvResume') };
const defs: AchievementDef[] = on('achievements') ? availableAchievements((await getCollection('achievements')).map((e) => e.data), { bgm }) : [];
const achievementLabels = {
  region: t(lang, 'achievement.region'),
  close: t(lang, 'achievement.dismiss'),
};
---
<!doctype html>
<html lang={lang} data-variant={variant} data-page={page} data-section={section} data-motion="full" data-sfx={sfx ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={HEAD_INIT_SCRIPT} />
    <script is:inline set:html={VIEWER_QUEUE_SCRIPT} />
    <HeadMeta lang={lang} title={title} description={description} siteName={v.identity.siteTitle[lang]} ogSlug={ogSlug} noindex={noindex} alternates={altHref !== null} jsonLd={jsonLd} analytics="always">
      {/* Page fonts (src/lib/fonts.ts): `astro build` replaces these placeholders with the sans subsets and the mono file
          (scripts/fonts/build.mjs); the preload tag format is what the rewrite looks for. */}
      <Fragment slot="fonts">
        <style is:inline set:html={fontFaceCss(['sans', 'mono'])}></style>
        <link rel="preload" href={FONT_URL.mono} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={FONT_URL.sans} as="font" type="font/woff2" crossorigin />
      </Fragment>
    </HeadMeta>
    <link rel="stylesheet" href={gameCss} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'site.skipToContent')}</a>
    <EdgeFrame />
    {page === 'home' && on('crtIntro') && <CrtIntro />}
    <HudNav lang={lang} variant={variant} current={section} exact={sectionIndex} altLangHref={altHref} cvHref={cv.href} cvLabel={cv.label} bgmAvailable={bgm} base={route?.kind === 'variant' ? route.base : null} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter lang={lang} notices={notices} builtAt={new Date()} />
    {on('achievements') && <AchievementHost lang={lang} defs={defs} labels={achievementLabels} />}
  </body>
</html>
