---
// /research/<id>/ (+ /en/): the paper page (D-15, owner's request) — the abstract only, typeset like the first
// page of the IEEE paper, on a white sheet over the dark HUD background. Built from the publication entry;
// HUD nav and footer stay. Page <title>/URL stay trademark-free; the <h1> is the real paper title.
import type { CollectionEntry } from 'astro:content';
import type { PageLayout } from '../layouts/page-layout';
import PaperSheet from '../components/research/PaperSheet.astro';
import { fontFaceCss } from '../lib/fonts';
import { toPaperPage } from '../lib/publications';
import { RIOT_NOTICE_ON_PAGES } from '../config';
import type { Lang } from '../i18n/ui';
import type { NoticeKey } from '../types';
import type { VariantId } from '../variants/ids';
import { getVariant, pageMetaFor } from '../variants';
import { getFactSource } from '../lib/portfolio';

interface Props {
  lang: Lang;
  variant: VariantId;
  entry: CollectionEntry<'publications'>;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

/** Preflight Q19: Riot notice on this page when RIOT_NOTICE_ON_PAGES is true; otherwise credits only. */
const PAPER_NOTICES: NoticeKey[] = RIOT_NOTICE_ON_PAGES ? ['riot'] : [];

const { lang, variant, entry, layout: Layout } = Astro.props;
const v = getVariant(variant);
const facts = await getFactSource();
const paper = toPaperPage(entry, lang);
const meta = pageMetaFor('research-story', lang, variant, facts);
// The Korean serif (Korean title gloss, 국문 초록, footnote) is set up on the Korean page only; the build subsets
// it to exactly the Hangul inside this page's sheet (scripts/fonts/build.mjs).
const koreanSerif = paper.titleKo !== null || paper.abstractKo !== null ? fontFaceCss(['serifKo']) : null;
// P2-5: the general version sets the sheet on the white page with a thin rule; the game keeps the HUD grid and frame.
const editorial = v.theme === 'editorial';
---
<Layout
  lang={lang}
  variant={variant}
  title={meta.title}
  description={meta.description}
  page="research-story"
  section="research"
  sectionIndex={false}
  notices={PAPER_NOTICES}
>
  {koreanSerif && <Fragment slot="head"><style is:inline set:html={koreanSerif}></style></Fragment>}
  {editorial ? (
    <div class="paper-view paper-view--ed">
      <div class="paper-view__sheet paper-view__sheet--ed">
        <PaperSheet lang={lang} paper={paper} />
      </div>
    </div>
  ) : (
    <div class="paper-view hud-grid">
      <div class="paper-view__frame bracket">
        <div class="paper-view__sheet">
          <PaperSheet lang={lang} paper={paper} />
        </div>
      </div>
    </div>
  )}
</Layout>

<style>
  /* Phones: the sheet spans the width (16px padding inside it). From 734px it floats on the HUD grid like a
     document open in a viewer, with the HUD's lime bracket corners around it (decoration only, D-11). */
  .paper-view { padding-block: 0; }
  .paper-view__frame { max-width: calc(46 * 17px + 24px); margin-inline: auto; border: 0; }
  .paper-view__frame::before, .paper-view__frame::after { display: none; }
  .paper-view__sheet { background: var(--paper-bg); }
  @media (min-width: 734px) {
    .paper-view { padding: 56px var(--gutter) 80px; }
    .paper-view__frame { padding: 12px; }
    .paper-view__frame::before, .paper-view__frame::after { display: block; }
    .paper-view__sheet { box-shadow: var(--paper-shadow); }
  }

  /* General version (P2-5): the white sheet on the white page with a thin rule instead of the HUD frame and shadow. */
  .paper-view--ed { background: var(--ed-bg); }
  .paper-view__sheet--ed { max-width: calc(46 * 17px + 24px); margin-inline: auto; }
  @media (min-width: 734px) {
    .paper-view--ed { padding: 40px var(--gutter) 64px; }
    .paper-view__sheet--ed { padding: 12px; border: var(--ed-rule-w) solid var(--ed-rule); box-shadow: none; }
  }

  /* Print: only the sheet, black on white — no nav, footer, toasts, grid, frame or shadow. */
  @media print {
    :global(html[data-page="research-story"] body > :not(main)) { display: none !important; }
    :global(html[data-page="research-story"]),
    :global(html[data-page="research-story"] body) { background: var(--paper-bg); color-scheme: light; }
    .paper-view { padding: 0; background: none; }
    .paper-view__frame { max-width: none; padding: 0; border: 0; }
    .paper-view__frame::before, .paper-view__frame::after { display: none; }
    .paper-view__sheet { box-shadow: none; }
  }
</style>
