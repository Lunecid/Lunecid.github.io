---
// Styles: src/styles/chooser.css (one external stylesheet for the chooser).
// The general file on the chooser desk (MO-23, chooser v6.4, finish B "판화지"): a printout lying askew on the game
// cover with one corner lifted, on white cotton-rag art paper (static tooth and formation, a blind plate mark, a soft
// deckle edge; no sprocket holes, no green bars, no tear perforation). Three hand-brushed Mondrian fields painted on
// after printing: red behind DATA (white type), a small yellow dab, a blue field at the foot. A typed job header and
// series line, the Korean h2, a rubber stamp (decoration), the tagline, the contents line and the link — ink with a fine
// underline; on hover or keyboard focus a yellow brush stroke sweeps in under it (transform only). One link; its hit
// layer covers the print. Type: the site's sans (MO-OQ16 stand-ins; MO-29 moves the banner to the general version's
// display face). MO-37 (v6.8/v6.12): a navy card folder under the sheet (it moves with it), a steel gem clip over the top
// edge and a yellow index flag repeating the file number on the right edge; all decoration. MO-39: the page-turn exit's
// page itself sits in .turn > .turn__in (clipped to its side of the fold while it turns, counter-moved so it stays
// still); the exit's other layers (the next sheet, the flap, the shades) are built by chooser.ts after load.
import { chooserCopy } from '../../data/copy/chooser';
import { coverCopy } from '../../data/copy/chooser-covers';
import type { CoverData } from '../../lib/chooser-covers';
import CoverEmblem from './CoverEmblem.astro';

interface Props {
  cover: CoverData;
}
const { cover } = Astro.props;
const copy = coverCopy[cover.lang];
const d = copy.data;
const kicker = chooserCopy[cover.lang].data.kicker;
const foot = copy.foot.replace('{year}', cover.foot.year).replace('{host}', cover.foot.host);
const clauses = cover.tagline.split(/(?<=,) /);
---
<article class="file file--data" aria-labelledby={`file-${cover.id}-title`}>
  <div class="face">
    <i class="folder" aria-hidden="true"></i>
    <i class="lift" aria-hidden="true"></i>
    <div class="feed">
      <div class="turn"><div class="turn__in">
      <div class="paper" aria-hidden="true"><i class="curl"></i></div>
      <div class="pr">
        <p class="pr__hdr" lang="en" aria-hidden="true"><span class="pr__file">{d.file}</span><span class="pr__no">{d.serial}</span></p>
        <div class="pr__head">
          <CoverEmblem kind="data" />
          <p class="pr__series"><span class="pr__pub" lang="en">{d.series}</span>&nbsp;<span class="pr__sep" aria-hidden="true">·</span> <span class="pr__kicker">{kicker}</span>&nbsp;<span class="pr__sep" aria-hidden="true">·</span> <span class="pr__sno" lang="en">{d.num}</span></p>
        </div>
        <p class="pr__disp" lang="en" aria-hidden="true"><span class="pr__row1"><span class="pr__red">{d.banner[0]}</span><i class="pr__dab"></i></span><span>{d.banner[1]}</span></p>
        <h2 class="pr__h2" id={`file-${cover.id}-title`}>{cover.title}</h2>
        <span class="rstamp" aria-hidden="true"><span class="rstamp__ink">{d.stamp}</span></span>
        <p class="pr__intro">{clauses.map((clause, i) => <>{i > 0 && ' '}<span class="cl">{clause}</span></>)}</p>
        <div class="pr__end">
          <ol class="pr__toc" role="list">
            {cover.contents.map((item) => <li><span class="toc__n" aria-hidden="true">{item.num}</span><span class="toc__t">{item.label}</span></li>)}
          </ol>
          <a class="cta cta--pr" href={cover.href} data-choose-variant={cover.id} aria-labelledby={`file-${cover.id}-title file-${cover.id}-cta`}><span class="cta__face"><i class="cta__hov" aria-hidden="true"></i><span id={`file-${cover.id}-cta`} class="cta__t">{cover.cta}</span> <span aria-hidden="true">→</span></span><span class="cta__hit" aria-hidden="true"></span></a>
        </div>
        <p class="pr__foot" lang="en" aria-hidden="true"><span class="pr__foot-t">{foot}</span><i class="pr__blue"></i></p>
      </div>
      </div></div>
      <svg class="clip" viewBox="0 0 22 70" aria-hidden="true" focusable="false"><g class="clip__sh"><path d="M3.5 18V61A7.5 7.5 0 0 0 18.5 61V24" transform="translate(2.6 3.4)" stroke-opacity=".1" stroke-width="4.4"></path><path d="M3.5 18V61A7.5 7.5 0 0 0 18.5 61V24" transform="translate(1.1 1.5)" stroke-opacity=".2" stroke-width="2.8"></path></g><g class="clip__w"><path class="clip__leg" d="M15 18V12" stroke-width="2.6"></path><path class="clip__edge" d="M15 18V9A5.75 5.75 0 0 0 3.5 9V61A7.5 7.5 0 0 0 18.5 61V24" stroke-width="2.8"></path><path class="clip__steel" d="M15 18V9A5.75 5.75 0 0 0 3.5 9V61A7.5 7.5 0 0 0 18.5 61V24" stroke-width="2.1"></path><path class="clip__hi" d="M15 18V9A5.75 5.75 0 0 0 3.5 9V61A7.5 7.5 0 0 0 18.5 61V24" stroke-width=".7" stroke-opacity=".95" transform="translate(-.4 -.4)"></path></g><path class="clip__seat" d="M12.5 18H17.5" stroke-opacity=".18" stroke-width="1"></path></svg>
      <span class="tab" aria-hidden="true"><span class="tab__t" lang="en">{d.num}</span></span>
    </div>
  </div>
</article>
