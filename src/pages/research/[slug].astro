---
import type { GetStaticPaths } from 'astro';
import ResearchPaperView from '../../views/ResearchPaperView.astro';
import { getPaperPages } from '../../lib/portfolio';
// Old route (deleted in P1-11, replaced by src/pages/[variant]/research/[slug].astro + variantPaperPaths).
export const getStaticPaths = (async () => (await getPaperPages()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;
---
<ResearchPaperView lang="ko" variant="game" entry={Astro.props.entry} />
