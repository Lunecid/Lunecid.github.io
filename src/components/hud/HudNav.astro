---
/**
 * Sticky HUD nav (mockup-port §2, spec §3/§5): [SB] brand, 01–04 section links, BGM, language, CV, mobile "메뉴" button.
 * Without JavaScript the mobile menu is shown in the page flow (only html.js hides it until opened).
 */
import type { Lang } from '../../i18n/ui';
import { languages } from '../../i18n/ui';
import { otherLang, t, type UiKey } from '../../i18n/utils';
import { homeHref, pageHref } from '../../lib/links';
import type { NavSection } from '../../types';
import { MEDIA } from '../../config';
import BgmToggle from './BgmToggle.astro';
import VariantSwitch from '../common/VariantSwitch.astro';
import { getVariant } from '../../variants';
import type { VariantId } from '../../variants/ids';

interface Props {
  lang: Lang;
  variant: VariantId;
  current?: NavSection;
  exact?: boolean;
  altLangHref: string | null;
  cvHref: string;
  /** Which PDF the CV button opens, e.g. "이력서 (PDF)" or "Academic CV (PDF)" (D-7): tooltip and accessible name. */
  cvLabel: string;
  bgmAvailable: boolean;
  base: string | null;
}
const { lang, variant, current, exact = false, altLangHref, cvHref, cvLabel, bgmAvailable, base } = Astro.props;
const other = otherLang(lang);
const NAV_LABEL: Record<NavSection, UiKey> = { research: 'nav.research', projects: 'nav.projects', records: 'nav.records', 'player-log': 'nav.playerLog' };
// Numbering ('01'…) is game markup (contract §1.6), taken from the position in the version nav.
const items = getVariant(variant).nav.map((item, i) => ({
  key: item.key,
  num: String(i + 1).padStart(2, '0'),
  label: t(lang, NAV_LABEL[item.key]),
  href: pageHref(item.base, { lang, variant }),
}));
const currentValue = exact ? 'page' : 'true';
---
<header class="hud-nav" data-open="false" data-hud-nav>
  <div class="hud-nav__bar">
    <a class="hud-nav__brand" href={homeHref(lang, variant)}>
      <span class="hud-nav__logo" aria-hidden="true">[SB]</span>
      <span class="hud-nav__id" lang="en">SEONGEUN_BAEK<span class="hud-nav__role"> // GAME DATA ANALYST</span></span>
      <span class="sr-only">{t(lang, 'nav.brandSr')}</span>
    </a>

    <nav id="hud-menu" class="hud-nav__panel" aria-label={t(lang, 'nav.label')}>
      <ul class="hud-nav__list" role="list">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.key ? currentValue : undefined}>
              <span class="hud-nav__num" aria-hidden="true">{item.num}</span> {item.label}
            </a>
          </li>
        ))}
      </ul>
      {altLangHref !== null && (
        <p class="hud-nav__lang hud-nav__lang--panel">
          <a href={altLangHref} hreflang={other} lang={other}>{languages[other]}</a>
        </p>
      )}
      {base !== null && <p class="hud-nav__switch hud-nav__switch--panel"><VariantSwitch lang={lang} variant={variant} base={base} placement="panel" /></p>}
    </nav>

    <div class="hud-nav__tools">
      {bgmAvailable && <BgmToggle src={MEDIA.bgm} />}
      {base !== null && <VariantSwitch lang={lang} variant={variant} base={base} placement="bar" />}
      {altLangHref !== null && (
        <p class="hud-nav__lang hud-nav__lang--bar">
          <span class="hud-nav__lang-cur">{lang.toUpperCase()}</span>
          <span aria-hidden="true"> / </span>
          <a href={altLangHref} hreflang={other} lang={other}>{other.toUpperCase()}<span class="sr-only"> {languages[other]}</span></a>
        </p>
      )}
      <a class="hud-nav__cv" href={cvHref} title={cvLabel} download>
        <span class="hud-nav__chip cut cut--line">{t(lang, 'nav.cv')} <span aria-hidden="true">↓</span></span>
        <span class="sr-only"> — {cvLabel}</span>
      </a>
      <button
        class="hud-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="hud-menu"
        data-nav-toggle
        data-label-closed={t(lang, 'nav.menu')}
        data-label-open={t(lang, 'nav.closeMenu')}
      >{t(lang, 'nav.menu')}</button>
    </div>
  </div>
  {/* P2-3 (controller ruling 2): a scrim behind the open panel so it never blends into the dark hero below it. */}
  <div class="hud-nav__scrim" data-nav-scrim aria-hidden="true"></div>
</header>

<script>
  import { initLangHashSync, initNavMenus } from '../../scripts/nav-menu';
  initNavMenus('[data-hud-nav]');
  initLangHashSync('[data-hud-nav] .hud-nav__lang a[hreflang]');
</script>

<style>
  .hud-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    /* F-024: near-opaque fill on the sticky shell. Blur lives on ::before so it does not turn
       position:fixed descendants (the menu scrim) into a zero-height containing-block trap. */
    background: var(--hud-bg);
    background: var(--hud-nav-bg);
    border-bottom: 1px solid var(--hud-line);
  }
  .hud-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--hud-nav-bg);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
  }
  .hud-nav__bar {
    position: relative;
    max-width: var(--container-hud);
    min-height: var(--nav-h);
    margin-inline: auto;
    padding-inline: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font: 500 13px/1 var(--font-mono);
  }
  .hud-nav__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--tap);
    min-width: var(--tap); /* P2-24: below 1068px only "[SB]" shows, so the link needs its own 44px width */
    color: var(--hud-text);
    text-decoration: none;
    transition: color var(--dur-hover) linear;
  }
  .hud-nav__logo {
    color: var(--accent);
    font-weight: 700;
  }
  .hud-nav__id,
  .hud-nav__role {
    display: none;
  }
  .hud-nav__list {
    display: flex;
    gap: 22px;
  }
  .hud-nav__list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    padding-inline: 2px;
    color: var(--hud-muted);
    text-decoration: none;
    transition: color var(--dur-hover) linear;
  }
  /* P-04 (F-026): a 2px accent underline next to the colour, so the current item reads in grayscale. */
  .hud-nav__list a[aria-current] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
    text-underline-offset: .35em;
  }
  .hud-nav__num {
    font-variant-numeric: tabular-nums;
  }
  .hud-nav__tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hud-nav__lang {
    color: var(--hud-muted);
  }
  .hud-nav__lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap); /* P2-24: "EN"/"KO" alone was ~24px wide on tablet */
    padding-inline: 4px;
    color: var(--hud-text);
    transition: color var(--dur-hover) linear;
  }
  .hud-nav__cv {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
    text-decoration: none;
  }
  .hud-nav__chip {
    --c: var(--cut-chip);
    --cut-fill: var(--hud-bg);
    display: inline-block;
    padding: 5px 10px;
    font-weight: 600;
  }
  .hud-nav__toggle {
    /* G-017: fixed ≤60px so open "×" and closed "Menu"/"메뉴" share one width (72px wraps EN at 305px). */
    box-sizing: border-box;
    width: 56px;
    min-height: var(--tap);
    min-width: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    border: 1px solid var(--hud-line);
    color: var(--hud-text);
    font: 600 13px/1 var(--font-sans);
    text-align: center;
    transition: border-color var(--dur-hover) linear, color var(--dur-hover) linear;
  }
  /* F-021 / F-022: colour hover only on hover-capable pointers; press states hold in both motion modes. */
  @media (hover: hover) {
    .hud-nav__list a:hover { color: var(--hud-text); }
    .hud-nav__brand:hover { color: var(--accent); }
    .hud-nav__lang a:hover { color: var(--accent); }
    .hud-nav__cv:hover .hud-nav__chip { --cut-fill: var(--accent-wash-strong); }
    .hud-nav__toggle:hover { border-color: var(--accent); color: var(--accent); }
  }
  .hud-nav__brand:active { color: var(--accent); }
  .hud-nav__lang a:active { color: var(--accent); }
  .hud-nav__cv:active .hud-nav__chip { --cut-fill: var(--accent-wash-strong); }
  .hud-nav__toggle:active { border-color: var(--accent); }
  /* P2-3 (controller ruling 2): the open state reads at a glance, not only through aria-expanded. */
  .hud-nav__toggle[aria-expanded="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hud-nav__scrim {
    display: none;
  }

  /* mobile: the bar holds [SB], BGM, CV and 메뉴. Without JS the panel sits in the flow under the bar. */
  @media (max-width: 733.98px) {
    .hud-nav__bar {
      flex-wrap: wrap;
    }
    .hud-nav__panel {
      order: 3;
      flex: 1 0 100%;
      padding: 4px 0 12px;
    }
    :global(html.js) .hud-nav__panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      z-index: 2;
      display: none;
      padding: 8px 16px 16px;
      background: var(--hud-bg);
      border-bottom: 1px solid var(--hud-line);
      /* G-011: 100% = sticky bar height (positioned containing block); keep last items reachable at 400% zoom. */
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .hud-nav[data-open="true"] .hud-nav__panel {
      display: block;
    }
    /* F-025 (P-05): a 150ms entrance on open; closing is instant (no visibility transition, style guard). */
    :global(html.js) .hud-nav[data-open="true"] .hud-nav__panel { animation: nav-panel-in 150ms var(--ease-out); }
    :global(html.js) .hud-nav[data-open="true"] .hud-nav__scrim { animation: nav-scrim-in 150ms linear; }
    /* P2-3: a scrim behind the panel, from the nav bar down to the bottom of the viewport, so the panel never
       blends into the dark hero behind it. The panel itself (opaque, z-index above) fully covers its own height.
       F-067 (P-05): the colour is the --scrim token. */
    :global(html.js) .hud-nav[data-open="true"] .hud-nav__scrim {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      top: var(--nav-h);
      bottom: 0;
      z-index: 1;
      background: var(--scrim);
    }
    .hud-nav__list {
      flex-direction: column;
      gap: 0;
    }
    .hud-nav__list a {
      width: 100%;
      min-height: 48px;
      font-size: 16px;
    }
    .hud-nav__lang--bar {
      display: none;
    }
    .hud-nav__tools {
      gap: 6px;
    }
    :global(html:not(.js)) .hud-nav {
      position: relative;
    }
    :global(html:not(.js)) .hud-nav__toggle {
      display: none;
    }
  }
  /* tablet: [SB] only. With SEONGEUN_BAEK added, the English bar (4 mono links + BGM + KO/EN + CV)
     is ≈ 820px wide and would scroll sideways at 768px (Review Focus 1). */
  @media (min-width: 734px) {
    .hud-nav__toggle,
    .hud-nav__lang--panel {
      display: none;
    }
    .hud-nav__switch--panel { display: none; }
    .hud-nav__list {
      gap: 16px;
    }
  }
  /* P1-15 (owner decision): with the version switch in the bar, the tablet bar drops the 01–04 numbers so it never
     scrolls sideways at 768px; from 1068px the numbers return. */
  @media (min-width: 734px) and (max-width: 1067.98px) {
    .hud-nav__num {
      display: none;
    }
  }
  @media (min-width: 1068px) {
    .hud-nav__bar {
      padding-inline: 28px;
    }
    .hud-nav__id { display: inline; }
    .hud-nav__list {
      gap: 22px;
    }
  }
  /* P1-15: "// GAME DATA ANALYST" only where the 1360px container leaves room beside the switch. */
  @media (min-width: 1600px) {
    .hud-nav__role {
      display: inline;
    }
  }
  /* F-023: match .container gutters only where the EN bar still fits; keep 16/28px below. */
  @media (min-width: 1200px) {
    .hud-nav__bar {
      padding-inline: var(--gutter);
    }
  }
  /* F-025 (P-05): the menu entrance keyframes (opacity and transform only) and their reduce paths. */
  @keyframes nav-panel-in { from { opacity: 0; transform: translateY(-8px); } }
  @keyframes nav-scrim-in { from { opacity: 0; } }
  :global(:root[data-motion="reduce"]) .hud-nav__panel,
  :global(:root[data-motion="reduce"]) .hud-nav__scrim { animation: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .hud-nav__panel, .hud-nav__scrim { animation: none !important; }
  }
</style>
