---
// Home (spec §3): hero → MAIN MENU → cartridges → research highlight → patch notes → hello profile.
// All copy hrefs are base form and built here with pageHref for the version; resume.yaml is the single source of name and
// education, the version identity (src/variants/*.ts) of tagline, status and about (site = PDFs).
// P2-7: the general version (spec §10.2) has DataHero (the heatmap as 그림 1) instead of the HUD hero, no MAIN MENU, the
// featured projects, the research highlight (its chart as 그림 2), NewsList instead of PATCH NOTES, and the profile.
import type { PageLayout } from '../layouts/page-layout';
import Hero from '../components/hud/Hero.astro';
import MainMenu from '../components/hud/MainMenu.astro';
import CartridgeSection from '../components/home/CartridgeSection.astro';
import ResearchHighlight from '../components/home/ResearchHighlight.astro';
import PatchNotes from '../components/home/PatchNotes.astro';
import HelloProfile from '../components/home/HelloProfile.astro';
import DataHero from '../components/data/DataHero.astro';
import NewsList from '../components/data/NewsList.astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import { homeHref, pageHref } from '../lib/links';
import { educationLine } from '../lib/records';
import { DOCUMENTS, SITE } from '../config';
import { heroCopy, mainMenuCopy, splitTagline } from '../data/copy/hero';
import { homeCopy } from '../data/copy/home';
import { dataHomeCopy } from '../data/copy/data/home';
import { HERO_SIZES, characterCredit, characters, getStageCharacters } from '../lib/characters';
import { getFactSource, getNews, getPerson, getProject, getPublications, getResume, resolveOrder } from '../lib/portfolio';
import { toCartridge, type CartridgeProps } from '../lib/projects';
import { toPaperCard, toPaperCartridge } from '../lib/publications';
import { toPatchNotes } from '../lib/news';
import { canonicalUrl, personJsonLd } from '../lib/seo';
import { resolveDeep } from '../lib/facts';
import { BASE_PATH, type ModuleId, type VariantId } from '../variants/ids';
import { captionFor, getVariant, pageMetaFor, resolveIdentity } from '../variants';

interface Props {
  lang: Lang;
  variant: VariantId;
  /** The page module's layout (P2-2a): BaseLayout or DataLayout, never imported here (CSS, contract §2.2). */
  layout: PageLayout;
}

const { lang, variant, layout: Layout } = Astro.props;
const ctx = { lang, variant };
const v = getVariant(variant);
const on = (m: ModuleId): boolean => v.modules.includes(m);
const facts = await getFactSource();

const resumeData = await getResume();
const { profile } = resumeData;
const identity = resolveIdentity(v, lang, facts);
const meta = pageMetaFor('home', lang, variant, facts);
const hero = resolveDeep(heroCopy[lang], lang, facts);
const menu = resolveDeep(mainMenuCopy[lang], lang, facts);
const home = resolveDeep(homeCopy[lang], lang, facts);
const person = await getPerson();
const editorial = v.theme === 'editorial';
const dataHome = resolveDeep(dataHomeCopy[lang], lang, facts);
// B-12: the general hero shows the school-zone risk heatmap, which is that project's cover (the common frame).
const heroCover = editorial ? (await getProject('school-zone-blindspots', lang)).data.cover : undefined;
const heroTitle = editorial ? (await getProject('school-zone-blindspots', lang)).data.title : '';
if (editorial && !heroCover) throw new Error('HomeView: school-zone-blindspots has no cover (the B-12 hero figure)');

// Character art is optional (Task 2): every call below returns [] / null / [] when it is missing.
const heroChars = on('characterArt') ? await getStageCharacters(['remielle', 'eula'], 'hero', lang) : [];
const leadChar = heroChars[0];
// Final fix 2 item 10: the MAIN MENU side art never shows the hero's character. It prefers Eula and switches to
// Remielle while the visitor has Eula on the hero (CharacterStage HERO_PICK_EVENT). With only one character's art
// the side would repeat the hero, so it takes the no-art MAIN MENU layout instead.
const sideCandidates = on('characterArt') ? await getStageCharacters(['eula', 'remielle'], 'side', lang) : [];
const sideChars = sideCandidates.some((c) => c.id !== leadChar?.id) ? sideCandidates : [];
const notices = on('characterArt') ? characters.notices(['remielle', 'eula']) : [];
const credit = on('characterArt') ? characterCredit(['remielle', 'eula'], lang) : null;

const toCard = (item: Awaited<ReturnType<typeof resolveOrder>>[number]): CartridgeProps =>
  item.kind === 'project' ? toCartridge(item.entry, ctx) : toPaperCartridge(item.entry, lang, pageHref(item.entry.data.caseStudy ?? '', ctx));
// D-3: the version's home row (game: CoG wide card + two projects = one row of four columns).
const featured = (await resolveOrder(v.orders.homeFeatured, lang)).map(toCard);

const publications = await getPublications();
const highlighted = publications.find((entry) => entry.data.highlight) ?? publications[0];
if (!highlighted) throw new Error('HomeView: no publication entry for the research highlight');
const paper = toPaperCard(highlighted, ctx);

const notes = toPatchNotes(await getNews(), ctx, 4);

const education = resumeData.education.map((e) => educationLine(e, lang));
const location = lang === 'ko' ? `${profile.location.ko} · ${profile.location.en}` : profile.location.en;
---

<Layout lang={lang} variant={variant} title={meta.title} description={meta.description} page="home" notices={notices} jsonLd={personJsonLd(lang, { jobTitle: identity.headline, url: canonicalUrl(homeHref(lang, variant)) }, resumeData.researchIds)}>
  {leadChar && leadChar.image.avifSrcSet && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={leadChar.image.avifSrcSet}
      imagesizes={HERO_SIZES}
      fetchpriority="high"
    />
  )}
  {leadChar && !leadChar.image.avifSrcSet && (
    <link slot="head" rel="preload" as="image" imagesrcset={leadChar.image.srcSet} imagesizes={HERO_SIZES} fetchpriority="high" />
  )}
  {editorial && heroCover ? (
    <DataHero
      lang={lang}
      caption={captionFor(v, 'heroLabel', lang)}
      name={person.name[lang]}
      headline={identity.headline}
      tagline={identity.tagline}
      status={identity.status}
      evidence={dataHome.evidence}
      projects={{ label: dataHome.cta.projects.label, href: pageHref(dataHome.cta.projects.href, ctx) }}
      cv={{ label: dataHome.cta.cv.label, href: DOCUMENTS[v.documents.resume[lang]], docLabel: t(lang, 'nav.cvResume') }}
      figure={{ src: heroCover.src, alt: heroCover.alt, caption: dataHome.heroFigure.caption, href: pageHref(dataHome.heroFigure.href, ctx), linkLabel: t(lang, 'action.viewProject'), projectTitle: heroTitle }}
    />
  ) : (
    <Hero
      lang={lang}
      chars={heroChars}
      name={profile.name[lang]}
      roman={hero.roman}
      label={hero.label}
      slogan={splitTagline(identity.tagline)}
      meta={hero.meta}
      status={identity.status}
      ctas={{ primary: { label: hero.ctas.primary.label, href: pageHref(hero.ctas.primary.href, ctx) } }}
      contact={{
        email: SITE.email,
        github: SITE.githubUrl,
        cvHref: DOCUMENTS[v.documents.resume[lang]],
        cvLabel: hero.contact.cvLabel,
        cvDocLabel: t(lang, 'nav.cvResume'),
        jobFitHref: pageHref(hero.contact.jobFitHref, ctx),
        jobFitLabel: hero.contact.jobFitLabel,
      }}
      artifact={{ ...hero.artifact, href: pageHref(hero.artifact.href, ctx) }}
      credit={credit}
      swap={hero.swap}
      playerCard={{ ...hero.playerCard, classLine: lang === 'ko' ? identity.headline : resolveIdentity(v, 'en', facts).headline.toUpperCase() }}
    />
  )}
  {on('mainMenu') && (
    <MainMenu
      lang={lang}
      items={menu.items.map((item) => ({ ...item, href: pageHref(item.href, ctx) }))}
      hint={menu.hint}
      side={sideChars}
    />
  )}
  <CartridgeSection lang={lang} variant={variant} cartridges={featured} moreHref={pageHref(BASE_PATH.projects, ctx)} moreLabel={editorial ? dataHome.moreProjects : home.moreProjects} />
  <ResearchHighlight lang={lang} variant={variant} paper={paper} nowPlaying={home.researchNowPlaying} figureLabel={hero.artifact.label} intro={editorial ? dataHome.researchSentence : undefined} figureNumber={editorial ? 2 : undefined} />
  {editorial ? <NewsList lang={lang} notes={notes} /> : <PatchNotes lang={lang} variant={variant} notes={notes} />}
  <HelloProfile
    lang={lang}
    variant={variant}
    about={identity.about}
    location={location}
    education={education}
    skills={resumeData.skills.primary.map((skill) => skill.name)}
    records={home.helloRecords}
    contact={{ email: SITE.email, github: SITE.githubUrl, cvHref: DOCUMENTS[v.documents.resume[lang]], cvDocLabel: t(lang, 'nav.cvResume') }}
    ids={resumeData.researchIds}
  />
</Layout>
