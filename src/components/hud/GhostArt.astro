---
// Faint grey character art in the empty side margins of wide light bands. Game version only: the four hosts render it
// behind characterArt (contract §1.8). Its rules sit in an inline style block right after the element and the image
// URLs on the element's style attribute: a scoped block would be inlined into every page whose view imports a host,
// rendered or not, so the general pages would carry the rules. The background exists only inside
// @media (min-width: 1600px), so narrower viewports never download it. No CSS mask, plain opacity (masks draw Chrome
// edge hairlines). Optional: a missing asset renders nothing.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;

const files = import.meta.glob<ImageMetadata>('../../assets/ghost/miku-v6.webp', {
  eager: true,
  import: 'default',
});
const src = Object.values(files)[0];
if (!src) return;

const webp = await getImage({ src, format: 'webp' });
const avif = await getImage({ src, format: 'avif' });
const vars = `--ghostWebp: url(${webp.src}); --ghostAvif: url(${avif.src})`;
---

<div class={`ghost-art ghost-art--${side}`} aria-hidden="true" data-ghost-art={side} style={vars}></div>
<style is:inline>
  /* Hidden below the first XL step: no background-image, so no network fetch. */
  .ghost-art {
    display: none;
  }
  @media (min-width: 1600px) {
    .ghost-art {
      display: block;
      position: absolute;
      bottom: 0;
      /* Side margin = outer half of (100vw - container) plus the container's inner gutter, minus 8px clearance. */
      width: calc((100vw - var(--container-hud)) / 2 + var(--gutter) - 8px);
      height: 100%;
      max-height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.07;
      background-image: image-set(var(--ghostAvif) type('image/avif'), var(--ghostWebp) type('image/webp'));
      background-repeat: no-repeat;
      background-size: contain;
      background-position: bottom center;
    }
    .ghost-art--left {
      left: 0;
    }
    .ghost-art--right {
      right: 0;
      transform: scaleX(-1);
    }
  }
</style>
